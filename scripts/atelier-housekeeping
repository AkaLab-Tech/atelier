#!/usr/bin/env bash
#
# atelier-housekeeping — daily, operator-authorized cleanup of the
# task-cycle debris that falls outside auto-merge's per-task cleanup:
#
#   - Orphan WORKTREES under <project>-worktrees/ whose task is no longer
#     claimed (see below) and whose PR is MERGED.
#   - Local task/* BRANCHES that are merged into the project's base branch (or whose PR is
#     merged/closed) and are not checked out.
#   - Remote origin/task/* BRANCHES whose PR is merged/closed.
#
# It NEVER deletes anything without an explicit operator authorization
# (interactive confirm, or --yes in non-interactive contexts). The default
# mode enumerates and confirms; --report / --dry-run only enumerate.
#
# Safety rails (always on, cannot be overridden by --yes):
#   - Never a protected branch (main/master/develop/staging).
#   - Never a branch/worktree with an OPEN PR.
#   - Never a CLAIMED task: board Status In Progress on github-project, or an
#     IN_PROGRESS.md reference (main checkout or the task's worktree; also
#     [BLOCKED]/[OVERSIZE]) on files. A claim that cannot be read (gh failing,
#     non-numeric id, no board item, linear) is "unknown" and also skipped.
#     The board is read from .githubProject.owner/projectNumber, with an
#     owner-side fallback when issue.projectItems cannot see the item
#     (cross-owner or user-owned aggregated boards).
#     On github-project `task/<N>-<slug>` carries the GitHub ISSUE number; the
#     board's Atelier ID is only a cross-check. An item whose Atelier ID differs
#     from N, or whose N is the Atelier ID of another issue, is a "mismatch":
#     kept and reported, never removed (not even with --yes/--include-unmerged).
#   - A worktree is removed only when its PR is MERGED; ancestry of base alone
#     never qualifies (a freshly cut task branch is an ancestor of base).
#   - Never a DIRTY worktree (uncommitted changes).
#   - Never force-delete UNMERGED work: unmerged-with-no-PR (or PR closed
#     unmerged) items are reported under "needs review" and skipped unless
#     the operator passes --include-unmerged.
#   - Never --force / never a non-fast-forward push.
#
# Cadence: each completed run stamps $ATELIER_CONFIG_DIR/housekeeping-last-check
# with today's date. The SessionStart hook (hooks/daily-housekeeping.sh)
# reads that stamp and nudges the operator at most once per calendar day.
#
# Usage:
#   atelier-housekeeping [--report|--dry-run] [--project PATH]
#                        [--include-unmerged] [--yes|-y] [--json] [--no-stamp]
#   atelier-housekeeping --help
#
# Exit codes:
#   0  swept successfully (nothing to do, reported, or deletions applied)
#   1  unrecoverable error (no config / malformed JSON / jq missing)
#   2  refusal (operator declined the confirmation in interactive mode)

set -euo pipefail
IFS=$'\n\t'

VERSION="0.1.0"
SCRIPT_NAME="$(basename "${BASH_SOURCE[0]}")"

# ---------- logging ----------
log()    { printf '==> %s\n' "$*"; }
sublog() { printf '    %s\n' "$*"; }
warn()   { printf '!!  %s\n' "$*" >&2; }
sublog_base() { printf '    %s\n' "$*" >&2; }
die()    { printf '!!  ERROR: %s\n' "$*" >&2; exit 1; }
ok()     { printf '    OK: %s\n' "$*"; }

# ---------- usage ----------
usage() {
  cat <<EOF
${SCRIPT_NAME} ${VERSION}

Operator-authorized cleanup of orphan worktrees and merged/closed task
branches (local + remote) across atelier-registered projects. Always asks
before deleting; --report / --dry-run only enumerate.

USAGE:
  ${SCRIPT_NAME} [--report|--dry-run] [--project PATH] [OPTIONS]
  ${SCRIPT_NAME} --help

OPTIONS:
  --report, --dry-run  Enumerate removable items and print the categorized
                       summary, then exit WITHOUT deleting anything. Safe to
                       run anytime. (Both flags are synonyms.)
  --project PATH       Limit the sweep to one registered project instead of
                       every project in \$ATELIER_CONFIG_DIR/projects.json.
  --include-unmerged   Also offer to remove items holding UNMERGED work
                       (orphan worktrees / branches with no PR, or a PR that
                       was closed without merging). Off by default — these
                       are listed under "needs review" and skipped.
  --yes, -y            Non-interactive. Apply deletions without the confirm
                       prompt. Required to delete in a non-TTY context.
  --json               Emit the enumeration as JSON instead of human text.
                       Implies --report (never deletes).
  --no-stamp           Do not update the daily cadence stamp. Useful when
                       scripting repeated runs.
  --help, -h           Show this help and exit.

EXIT CODES:
  0  swept successfully (nothing to do, reported, or deletions applied)
  1  unrecoverable error
  2  refusal (operator declined)
EOF
}

# ---------- arg parse ----------
MODE="sweep"             # sweep | report
PROJECT_FILTER=""
INCLUDE_UNMERGED=false
NONINTERACTIVE=false
JSON=false
STAMP=true
[ -n "${ATELIER_AUTO:-}" ] && NONINTERACTIVE=true

while [ $# -gt 0 ]; do
  case "$1" in
    --report|--dry-run) MODE="report"; shift ;;
    --project)          PROJECT_FILTER="${2:-}"; [ -n "$PROJECT_FILTER" ] || die "--project needs a path"; shift 2 ;;
    --include-unmerged) INCLUDE_UNMERGED=true; shift ;;
    --yes|-y)           NONINTERACTIVE=true; shift ;;
    --json)             JSON=true; MODE="report"; shift ;;
    --no-stamp)         STAMP=false; shift ;;
    --help|-h)          usage; exit 0 ;;
    *)                  die "unknown arg: $1 (run --help for usage)" ;;
  esac
done

# ---------- config + deps ----------
ATELIER_CONFIG_DIR="${ATELIER_CONFIG_DIR:-$HOME/.claude-work}"
CONFIG_FILE="$ATELIER_CONFIG_DIR/projects.json"
STAMP_FILE="$ATELIER_CONFIG_DIR/housekeeping-last-check"

command -v jq  >/dev/null 2>&1 || die "jq not found in PATH"
command -v git >/dev/null 2>&1 || die "git not found in PATH"
HAVE_GH=false
command -v gh >/dev/null 2>&1 && HAVE_GH=true

[ -f "$CONFIG_FILE" ] || die "$CONFIG_FILE not found — atelier may not be installed (run install.sh)"
jq empty "$CONFIG_FILE" >/dev/null 2>&1 || die "$CONFIG_FILE is not valid JSON"

# Today's date (YYYY-MM-DD). Used only for the cadence stamp.
TODAY="$(date +%F 2>/dev/null || true)"

PROTECTED_BRANCHES="main master develop staging"

is_protected_branch() {
  local b="$1"
  case " $PROTECTED_BRANCHES " in *" $b "*) return 0 ;; esac
  return 1
}

# ---------- resolve target projects ----------
PROJECTS=()
if [ -n "$PROJECT_FILTER" ]; then
  case "$PROJECT_FILTER" in /*) ;; *) PROJECT_FILTER="$(pwd)/$PROJECT_FILTER" ;; esac
  [ -d "$PROJECT_FILTER" ] && PROJECT_FILTER="$(cd -P "$PROJECT_FILTER" && pwd)"
  jq -e --arg p "$PROJECT_FILTER" '.projects[$p]' "$CONFIG_FILE" >/dev/null 2>&1 \
    || die "$PROJECT_FILTER is not registered in $CONFIG_FILE"
  PROJECTS+=("$PROJECT_FILTER")
else
  while IFS= read -r p; do
    [ -n "$p" ] && PROJECTS+=("$p")
  done < <(jq -r '.projects | keys[]' "$CONFIG_FILE" 2>/dev/null)
fi

# ---------- repo / PR helpers ----------

# Resolve OWNER/NAME for a project from its origin remote (HTTPS or SSH form).
repo_slug() {
  local proj="$1" url slug
  url="$(git -C "$proj" remote get-url origin 2>/dev/null || true)"
  [ -n "$url" ] || { printf ''; return; }
  slug="${url%.git}"
  slug="${slug#https://github.com/}"
  slug="${slug#git@github.com:}"
  slug="${slug#ssh://git@github.com/}"
  case "$slug" in */*) printf '%s' "$slug" ;; *) printf '' ;; esac
}

# Echo the PR state for a head branch: MERGED | CLOSED | OPEN | NONE | UNKNOWN.
# Conservative: any failure to determine returns UNKNOWN (treated as not-safe).
pr_state() {
  local slug="$1" branch="$2" out
  $HAVE_GH || { printf 'UNKNOWN'; return; }
  [ -n "$slug" ] || { printf 'UNKNOWN'; return; }
  out="$(env GH_CONFIG_DIR="$ATELIER_CONFIG_DIR/gh/author" gh pr list \
           --repo "$slug" --head "$branch" --state all \
           --json state --jq '.[0].state // "NONE"' 2>/dev/null || true)"
  case "$out" in
    MERGED|CLOSED|OPEN|NONE) printf '%s' "$out" ;;
    *)                       printf 'UNKNOWN' ;;
  esac
}

# resolve_base <proj> — sets BASE, BASE_SRC, BASE_REASON via atelier-resolve-base
# (GitHub defaultBranchRef, then origin/HEAD; never a `main` fallback).
BASE=""; BASE_SRC=""; BASE_REASON=""; BASE_REF=""
resolve_base() {
  local proj="$1" rb out k v
  BASE=""; BASE_SRC=""; BASE_REASON=""; BASE_REF=""
  rb="$(command -v atelier-resolve-base || true)"
  [ -n "$rb" ] || rb="$(dirname "${BASH_SOURCE[0]}")/atelier-resolve-base"
  if [ -x "$rb" ]; then
    out="$(env GH_CONFIG_DIR="$ATELIER_CONFIG_DIR/gh/author" "$rb" "$proj" 2>/dev/null || true)"
    while IFS='=' read -r k v; do
      case "$k" in base) BASE="$v" ;; source) BASE_SRC="$v" ;; reason) BASE_REASON="$v" ;; esac
    done <<<"$out"
  else
    BASE_REASON="atelier-resolve-base not found"
  fi
  [ -n "$BASE" ] || { BASE=""; return 0; }
  if git -C "$proj" show-ref --verify --quiet "refs/heads/$BASE"; then
    BASE_REF="$BASE"
  elif git -C "$proj" show-ref --verify --quiet "refs/remotes/origin/$BASE"; then
    BASE_REF="origin/$BASE"
  fi
}

# Task id embedded in a task/<id>-<slug> branch (portion before the first dash).
branch_task_id() {
  local b="${1#task/}"
  printf '%s' "${b%%-*}"
}

# Claim context for the project being enumerated (set by load_claims).
CLAIM_BACKEND=""; BOARD_CLAIMS=""; CLAIM_SRC=""; CLAIM_PROJ_REASON=""

# Owner-side fallback for ids the issue side left at "no item on project #PN"
# (issue.projectItems cannot see items of a board owned by another account, or
# of a user-owned aggregated board). One cursor-paged scan of the configured
# board filtered to the repo; only those ids' BOARD_CLAIMS lines are rewritten.
# Every failure keeps the ids unknown (fail closed) with a clear reason.
load_claims_owner_scan() {
  local slug="$1" owner="$2" pn="$3" ip="$4" aidf="$5"
  local ids line id q out cursor="" page=0 more=1 err="" found="" pg res rep
  ids="$(printf '%s\n' "$BOARD_CLAIMS" | awk -F'\t' -v r="no item on project #$pn" '$2 == "unknown" && $3 == r { print $1 }')"
  [ -n "$ids" ] || return 0
  q="query(\$c:String){o:repositoryOwner(login:\"$owner\"){...on ProjectV2Owner{p:projectV2(number:$pn){items(first:100,after:\$c,query:\"repo:$slug\"){pageInfo{hasNextPage endCursor} nodes{content{...on Issue{number repository{nameWithOwner}}} st:fieldValueByName(name:\"Status\"){...on ProjectV2ItemFieldSingleSelectValue{name}} $aidf}}}}}}"
  while [ "$more" = 1 ] && [ "$page" -lt 10 ]; do
    page=$((page + 1))
    local rc=0
    if [ -n "$cursor" ]; then
      out="$(env GH_CONFIG_DIR="$ATELIER_CONFIG_DIR/gh/author" gh api graphql -f query="$q" -f c="$cursor" 2>/dev/null)" || rc=$?
    else
      out="$(env GH_CONFIG_DIR="$ATELIER_CONFIG_DIR/gh/author" gh api graphql -f query="$q" 2>/dev/null)" || rc=$?
    fi
    if ! printf '%s' "$out" | jq -e '.data.o.p.items | type == "object"' >/dev/null 2>&1; then
      err="$(printf '%s' "$out" | jq -r '.errors[0].message // empty' 2>/dev/null || true)"
      err="${err:-gh api graphql exit $rc}"
      break
    fi
    pg="$(printf '%s' "$out" | jq -r --argjson ip "$ip" --arg slug "$slug" '
      def norm: (if . == null then "" else tostring end) | gsub("^\\s+|\\s+$"; "") | sub("^#"; "") | sub("\\.0+$"; "");
      .data.o.p.items.nodes[]?
      | select((.content.number? // null) != null
               and ((.content.repository.nameWithOwner // "") | ascii_downcase) == ($slug | ascii_downcase))
      | (.aid // {} | (.text // .number // "") | norm) as $a
      | (.st.name // "") as $s
      | "\(.content.number)\t\(if any($ip[]; . == $s) then "claimed" else "free" end)\t\($a)"')"
    [ -z "$pg" ] || found="$found$pg"$'\n'
    more=0; cursor=""
    if [ "$(printf '%s' "$out" | jq -r '.data.o.p.items.pageInfo.hasNextPage')" = true ]; then
      cursor="$(printf '%s' "$out" | jq -r '.data.o.p.items.pageInfo.endCursor')"
      more=1
    fi
    # stop early once every id has been seen
    local all=1
    for id in $ids; do
      printf '%s' "$found" | awk -F'\t' -v i="$id" '$1 == i { f = 1 } END { exit !f }' || all=0
    done
    [ "$all" = 1 ] && { more=0; break; }
  done
  [ -z "$err" ] || warn "board: cannot read project $owner/#$pn with the author identity: $err"
  res=""
  for id in $ids; do
    line="$(printf '%s' "$found" | awk -F'\t' -v i="$id" '$1 == i { print; exit }')"
    if [ -n "$line" ]; then
      local st aid
      st="$(printf '%s' "$line" | cut -f2)"; aid="$(printf '%s' "$line" | cut -f3)"
      if [ -n "$aid" ] && [ "$aid" != "$id" ]; then
        rep="$id"$'\t'"mismatch"$'\t'"board Atelier ID is $aid"
      else
        rep="$id"$'\t'"$st"$'\t'
      fi
    elif [ -n "$err" ]; then
      rep="$id"$'\t'"unknown"$'\t'"cannot read project $owner/#$pn with the author identity: $err"
    elif [ "$more" = 1 ]; then
      rep="$id"$'\t'"unknown"$'\t'"board scan truncated at 1000 items — claim unknown"
    else
      rep="$id"$'\t'"unknown"$'\t'"no item for $slug#$id on project $owner/#$pn"
    fi
    res="$res$rep"$'\n'
  done
  BOARD_CLAIMS="$(awk -F'\t' 'NR == FNR { m[$1] = $0; next } ($1 in m) { print m[$1]; next } { print }' \
    <(printf '%s' "$res") <(printf '%s\n' "$BOARD_CLAIMS"))"
}

# Resolve the backend once and, on github-project, read every candidate task's
# board Status with ONE batched, aliased `gh api graphql` (never item-list,
# never the cache: a deletion gate must not read stale data). BOARD_CLAIMS gets
# "<id>\t<claimed|free|mismatch|unknown>\t<detail>" lines, read per item from
# the (possibly partial) GraphQL data: one unresolvable issue makes only that
# id unknown. Ids absent from BOARD_CLAIMS fall back to CLAIM_PROJ_REASON.
# The same call also carries the Atelier ID cross-check: shape A (the item's
# own Atelier ID is set and != N) and shape B (an owner-level lookup finds
# another same-repo issue whose Atelier ID == N). Mismatch overrides claimed
# and free; an unreadable cross-check makes the id unknown.
load_claims() {
  local proj="$1" slug="$2"; shift 2
  local cfg="$proj/.roadmap.json" tb pn ip q id out rc=0 msg owner
  BOARD_CLAIMS=""; CLAIM_PROJ_REASON=""
  tb="$(command -v atelier-task-backend || true)"
  [ -n "$tb" ] || tb="$(dirname "${BASH_SOURCE[0]}")/atelier-task-backend"
  CLAIM_BACKEND="$("$tb" "$proj" 2>/dev/null || true)"
  [ "$CLAIM_BACKEND" = "github-project" ] || return 0
  $HAVE_GH && [ -f "$cfg" ] && [ -n "$slug" ] && [ $# -gt 0 ] || return 0
  pn="$(jq -r '.githubProject.projectNumber // empty' "$cfg" 2>/dev/null || true)"
  case "$pn" in ''|*[!0-9]*) return 0 ;; esac
  ip="$(jq -c '(.githubProject.stateMap.inProgress // ["In Progress"]) | if type=="array" then . else [.] end' "$cfg" 2>/dev/null)" || return 0
  owner="$(jq -r '.githubProject.owner // empty' "$cfg" 2>/dev/null || true)"
  case "$owner" in ''|*[!A-Za-z0-9._-]*) owner="${slug%%/*}" ;; esac
  local aidf='aid:fieldValueByName(name:"Atelier ID"){...on ProjectV2ItemFieldTextValue{text} ...on ProjectV2ItemFieldNumberValue{number}}'
  local ob=""
  q="query{r:repository(owner:\"${slug%%/*}\",name:\"${slug#*/}\"){"
  for id in "$@"; do
    q="$q i$id:issue(number:$id){projectItems(first:10){nodes{project{number owner{...on User{login} ...on Organization{login}}} fieldValueByName(name:\"Status\"){...on ProjectV2ItemFieldSingleSelectValue{name}} $aidf}}}"
    ob="$ob a$id:items(first:5,query:\"\\\"Atelier ID\\\":$id\"){nodes{content{...on Issue{number repository{nameWithOwner}}} $aidf}}"
  done
  q="$q},o:repositoryOwner(login:\"$owner\"){...on ProjectV2Owner{p:projectV2(number:$pn){$ob}}}"
  # gh exits 1 on a partial result (one alias null) but still prints the body.
  out="$(env GH_CONFIG_DIR="$ATELIER_CONFIG_DIR/gh/author" gh api graphql -f query="$q}" 2>/dev/null)" || rc=$?
  if ! printf '%s' "$out" | jq -e '.data.r | type == "object"' >/dev/null 2>&1; then
    msg="$(printf '%s' "$out" | jq -r '.errors[0].message // empty' 2>/dev/null || true)"
    CLAIM_PROJ_REASON="${msg:-board query failed (gh api graphql exit $rc)}"
    return 0
  fi
  BOARD_CLAIMS="$(printf '%s' "$out" | jq -r --argjson pn "$pn" --argjson ip "$ip" --arg slug "$slug" --arg owner "$owner" '
    def pm: .project.number == $pn and ((.project.owner.login // "") | ascii_downcase) == ($owner | ascii_downcase);
    def norm: (if . == null then "" else tostring end) | gsub("^\\s+|\\s+$"; "") | sub("^#"; "") | sub("\\.0+$"; "");
    def aidv: (.aid // {}) | (.text // .number // "") | norm;
    (.errors // []) as $errs
    | (.data.o.p) as $p
    | .data.r | to_entries[] | .key[1:] as $id
    | (if .value == null then []
       else [.value.projectItems.nodes[]? | select(pm) | aidv | select(. != "" and . != $id)] end) as $ma
    | (if ($p | type) == "object" and ($p["a\($id)"] == null or (($p["a\($id)"].nodes?) | type) == "array")
       then [($p["a\($id)"].nodes // [])[]
             | select(aidv == $id and ((.content.number? // null) != null)
                      and ((.content.repository.nameWithOwner // "") | ascii_downcase) == ($slug | ascii_downcase)
                      and .content.number != ($id | tonumber))
             | .content.number]
       else null end) as $mb
    | (if .value == null then ["unknown", ([$errs[] | select(.path == ["r", "i\($id)"]) | .message][0]) // "could not resolve issue #\($id)"]
       else [.value.projectItems.nodes[]? | select(pm)] as $m
         | if ($m | length) == 0 then ["unknown", "no item on project #\($pn)"]
           else [(if any($m[]; (.fieldValueByName.name // "") as $s | any($ip[]; . == $s)) then "claimed" else "free" end), ""]
           end
       end) as $b
    | if ($ma | length) > 0 then "\($id)\tmismatch\tboard Atelier ID is \($ma[0])"
      elif $mb != null and ($mb | length) > 0 then "\($id)\tmismatch\tAtelier ID #\($id) is issue #\($mb[0])"
      elif $mb == null and $b[0] != "unknown" then "\($id)\tunknown\tAtelier ID cross-check unreadable"
      else "\($id)\t\($b[0])\t\($b[1])" end' 2>/dev/null)" || BOARD_CLAIMS=""
  [ -n "$BOARD_CLAIMS" ] || CLAIM_PROJ_REASON="board query returned no readable items"
  [ -z "$BOARD_CLAIMS" ] || load_claims_owner_scan "$slug" "$owner" "$pn" "$ip" "$aidf"
  local bad
  bad="$(printf '%s\n' "$BOARD_CLAIMS" | awk -F'\t' '$2 == "unknown" { print "task/" $1 }' | paste -sd, - | sed 's/,/, /g')"
  [ -z "$bad" ] || warn "board: some task branches unresolvable ($bad)"
}

# Claim state of a task: 0 claimed, 1 not claimed, 2 unknown (fail closed),
# 3 Atelier ID mismatch (github-project; kept and reported).
# files: the id/branch appears in IN_PROGRESS.md of the main checkout (where
# [BLOCKED]/[OVERSIZE] land) or of the task's own worktree (where /next-task
# records the claim). github-project: board Status in stateMap.inProgress.
# Anything else (linear, unresolvable, unreadable board) is unknown.
task_claimed() {
  local proj="$1" id="$2" branch="$3" wt="${4:-}" f s line
  CLAIM_SRC=""
  case "$CLAIM_BACKEND" in
    files)
      for f in "$proj/IN_PROGRESS.md" ${wt:+"$wt/IN_PROGRESS.md"}; do
        [ -f "$f" ] || continue
        if grep -qF -- "$branch" "$f" 2>/dev/null \
           || grep -qE "(^|[^A-Za-z0-9_])#?${id//./\\.}([^A-Za-z0-9_]|\$)" "$f" 2>/dev/null; then
          CLAIM_SRC="IN_PROGRESS.md"; return 0
        fi
      done
      return 1 ;;
    github-project)
      line="$(printf '%s\n' "$BOARD_CLAIMS" | awk -F'\t' -v i="$id" '$1 == i { print; exit }')"
      s="$(printf '%s' "$line" | cut -f2)"
      case "$s" in
        claimed) CLAIM_SRC="board Status In Progress"; return 0 ;;
        free)    return 1 ;;
        mismatch) CLAIM_SRC="$(printf '%s' "$line" | cut -f3)"; return 3 ;;
      esac
      CLAIM_SRC="$(printf '%s' "$line" | cut -f3)"
      [ -n "$CLAIM_SRC" ] || CLAIM_SRC="${CLAIM_PROJ_REASON:-no board item found}"
      return 2 ;;
  esac
  return 2
}

# claim_gate <proj> <kind> <target> <id> <branch> [<worktree>] — returns 0
# (after recording a skip) when the item must be left untouched.
claim_gate() {
  local rc=0
  task_claimed "$1" "$4" "$5" "${6:-}" || rc=$?
  case "$rc" in
    0) add_skip "$1" "$2" "$3" "claimed task #$4 ($CLAIM_SRC)"; return 0 ;;
    3) add_skip "$1" "$2" "$3" "issue/Atelier ID mismatch for #$4 ($CLAIM_SRC) — left untouched"; return 0 ;;
    2) add_skip "$1" "$2" "$3" "claim state unknown for #$4 ($5): ${CLAIM_SRC:-no readable claim source} — left untouched"; return 0 ;;
  esac
  return 1
}

# ---------- enumerate ----------
# Each removable item is recorded as a TSV line in one of the arrays:
#   "<project>\t<kind>\t<branch-or-path>\t<reason>\t<command-token>"
# command-token tells the executor how to delete it.
declare -a DEL_WORKTREES=()   # safe-to-remove worktrees
declare -a DEL_LBRANCHES=()   # safe-to-remove local branches
declare -a DEL_RBRANCHES=()   # safe-to-remove remote branches
declare -a PRUNE_REFS=()      # stale origin/task/* tracking refs (head already gone on origin)
declare -a REVIEW=()          # unmerged / unknown — needs operator review
declare -a SKIPPED=()         # protected, for transparency (only shown in report)

add_review()  { REVIEW+=("$1"$'\t'"$2"$'\t'"$3"$'\t'"$4"); }
add_skip()    { SKIPPED+=("$1"$'\t'"$2"$'\t'"$3"$'\t'"$4"); }

# Push URL of origin (what `push --delete` talks to); falls back to the remote name.
push_url() { git -C "$1" remote get-url --push origin 2>/dev/null || echo origin; }

# delete_remote_branch <proj> <branch>: a branch already gone from origin counts as success.
delete_remote_branch() {
  local p="$1" b="$2" err rc=0
  if err="$(git -C "$p" push origin --delete "$b" 2>&1 >/dev/null)"; then
    sublog "deleted remote branch origin/$b"; return 0
  fi
  GIT_TERMINAL_PROMPT=0 git -C "$p" ls-remote --exit-code --heads "$(push_url "$p")" "refs/heads/$b" >/dev/null 2>&1 || rc=$?
  case "$rc" in
    2) git -C "$p" update-ref -d "refs/remotes/origin/$b" 2>/dev/null || true
       sublog "origin/$b already deleted" ;;
    0) warn "could not delete remote branch origin/$b: $(printf '%s' "$err" | grep -m1 .)" ;;
    *) warn "could not delete remote branch origin/$b: $(printf '%s' "$err" | grep -m1 .) (could not confirm with ls-remote)" ;;
  esac
}

enumerate_project() {
  local proj="$1"
  [ -d "$proj" ] || { add_skip "$proj" "project" "$proj" "directory missing"; return; }
  git -C "$proj" rev-parse --git-dir >/dev/null 2>&1 \
    || { add_skip "$proj" "project" "$proj" "not a git repo"; return; }

  local slug; slug="$(repo_slug "$proj")"
  local main_root; main_root="$(cd -P "$proj" && pwd)"

  local -a cand_ids=()
  while IFS= read -r line; do
    [ -n "$line" ] && cand_ids+=("$line")
  done < <({ git -C "$proj" worktree list --porcelain 2>/dev/null | sed -nE 's#^branch refs/heads/task/([0-9]+)-.*#\1#p'
             git -C "$proj" for-each-ref --format='%(refname)' refs/heads/task refs/remotes/origin/task 2>/dev/null \
               | sed -nE 's#^refs/(heads|remotes/origin)/task/([0-9]+)-.*#\2#p'; } | sort -u)
  load_claims "$proj" "$slug" ${cand_ids[@]+"${cand_ids[@]}"}

  resolve_base "$proj"
  local base="$BASE" base_ref="$BASE_REF"
  if [ -z "$base" ]; then
    add_skip "$proj" "project" "$proj" "base branch unresolved — merged-branch deletion skipped (${BASE_REASON:-unknown})"
  else
    sublog_base "$(basename "$proj"): base $base (source: $BASE_SRC)"
    [ -n "$base_ref" ] || add_skip "$proj" "project" "$proj" "base branch $base has no local or origin ref — merged-branch deletion skipped"
  fi

  # ----- worktrees -----
  # Parse `git worktree list --porcelain`: blocks separated by blank lines,
  # each with `worktree <path>` and (optionally) `branch refs/heads/<name>`.
  local wt_path="" wt_branch=""
  flush_worktree() {
    [ -n "$wt_path" ] || return 0
    local path="$wt_path" branch="$wt_branch"
    wt_path=""; wt_branch=""
    # Skip the main worktree itself.
    [ "$path" = "$main_root" ] && return 0
    # Only manage task/* worktrees; leave anything else alone.
    case "$branch" in task/*) ;; *) return 0 ;; esac
    is_protected_branch "$branch" && return 0

    local id; id="$(branch_task_id "$branch")"
    claim_gate "$proj" "worktree" "$path" "$id" "$branch" "$path" && return 0
    # Dirty worktree → never auto-remove.
    if [ -n "$(git -C "$path" status --porcelain 2>/dev/null)" ]; then
      add_skip "$proj" "worktree" "$path" "uncommitted changes — left untouched"
      return 0
    fi
    local st; st="$(pr_state "$slug" "$branch")"
    local merged=false
    [ -n "$base_ref" ] && git -C "$proj" branch --merged "$base_ref" 2>/dev/null | sed 's/^[+* ]*//' | grep -qxF "$branch" && merged=true
    if [ "$st" = "MERGED" ]; then
      DEL_WORKTREES+=("$proj"$'\t'"worktree"$'\t'"$path"$'\t'"branch $branch (PR:$st)"$'\t'"$branch")
    elif [ "$st" = "OPEN" ]; then
      add_skip "$proj" "worktree" "$path" "open PR for $branch"
    elif [ "$st" = "CLOSED" ]; then
      add_review "$proj" "worktree" "$path" "PR closed without merging (unmerged) — $branch"
    elif $merged; then
      add_skip "$proj" "worktree" "$path" "branch has no commits beyond base and no PR — likely a freshly claimed task; left untouched"
    else
      # NONE / UNKNOWN, not merged → possibly unmerged work.
      add_review "$proj" "worktree" "$path" "orphan, unmerged ($branch, PR:$st)"
    fi
  }

  while IFS= read -r line; do
    case "$line" in
      "worktree "*) flush_worktree; wt_path="${line#worktree }" ;;
      "branch "*)   wt_branch="${line#branch refs/heads/}" ;;
      "")           flush_worktree ;;
    esac
  done < <(git -C "$proj" worktree list --porcelain 2>/dev/null)
  flush_worktree

  # Paths still backing a kept worktree must not have their branch deleted.
  local kept_branches="" queued_branches="" row qp qb
  for row in ${DEL_WORKTREES[@]+"${DEL_WORKTREES[@]}"}; do
    IFS=$'\t' read -r qp _ _ _ qb <<<"$row"
    [ "$qp" = "$proj" ] && queued_branches="$queued_branches $qb"
  done
  while IFS= read -r line; do
    case "$line" in "branch refs/heads/"*) kept_branches="$kept_branches ${line#branch refs/heads/}" ;; esac
  done < <(git -C "$proj" worktree list --porcelain 2>/dev/null)
  local current_branch; current_branch="$(git -C "$proj" symbolic-ref --short HEAD 2>/dev/null || true)"

  # ----- local task/* branches -----
  local b
  while IFS= read -r b; do
    b="${b#refs/heads/}"
    [ -n "$b" ] || continue
    case "$b" in task/*) ;; *) continue ;; esac
    is_protected_branch "$b" && continue
    # Checked out / backing a worktree we keep → never touch.
    [ "$b" = "$current_branch" ] && { add_skip "$proj" "local-branch" "$b" "currently checked out"; continue; }
    case " $kept_branches " in *" $b "*)
      case " $queued_branches " in
        *" $b "*) add_skip "$proj" "local-branch" "$b" "backs a worktree queued for removal this run" ;;
        *)        add_skip "$proj" "local-branch" "$b" "backs a retained worktree" ;;
      esac
      continue ;;
    esac

    local id; id="$(branch_task_id "$b")"
    claim_gate "$proj" "local-branch" "$b" "$id" "$b" && continue
    local merged=false
    [ -n "$base_ref" ] && git -C "$proj" branch --merged "$base_ref" 2>/dev/null | sed 's/^[+* ]*//' | grep -qxF "$b" && merged=true
    local st; st="$(pr_state "$slug" "$b")"
    if $merged; then
      DEL_LBRANCHES+=("$proj"$'\t'"local-branch"$'\t'"$b"$'\t'"merged into $base"$'\t'"-D")  # -D is safe: ancestry against $base_ref is proven; -d would check HEAD/upstream and refuse when base != HEAD
    elif [ "$st" = "MERGED" ]; then
      DEL_LBRANCHES+=("$proj"$'\t'"local-branch"$'\t'"$b"$'\t'"PR merged (squash)"$'\t'"-D")
    elif [ "$st" = "OPEN" ]; then
      add_skip "$proj" "local-branch" "$b" "open PR"
    elif [ "$st" = "CLOSED" ]; then
      add_review "$proj" "local-branch" "$b" "PR closed without merging (unmerged)"
    else
      add_review "$proj" "local-branch" "$b" "not merged into ${base:-the base branch}"
    fi
  done < <(git -C "$proj" for-each-ref --format='%(refname)' refs/heads/task 2>/dev/null)

  # ----- remote origin/task/* branches -----
  local live="" live_ok=false
  if live="$(GIT_TERMINAL_PROMPT=0 git -C "$proj" ls-remote --heads "$(push_url "$proj")" 'refs/heads/task/*' 2>/dev/null)"; then
    live_ok=true
  else
    warn "$proj: could not list origin heads; stale tracking refs not detected"
  fi
  while IFS= read -r b; do
    b="${b#refs/remotes/origin/}"
    [ -n "$b" ] || continue
    case "$b" in task/*) ;; *) continue ;; esac
    is_protected_branch "$b" && continue
    if $live_ok && ! printf '%s\n' "$live" | grep -qE "[[:space:]]refs/heads/${b}\$"; then
      add_skip "$proj" "remote-branch" "origin/$b" "already gone on origin (stale local tracking ref)"
      PRUNE_REFS+=("$proj"$'\t'"$b")
      continue
    fi
    local id; id="$(branch_task_id "$b")"
    claim_gate "$proj" "remote-branch" "origin/$b" "$id" "$b" && continue
    local st; st="$(pr_state "$slug" "$b")"
    if [ "$st" = "MERGED" ]; then
      DEL_RBRANCHES+=("$proj"$'\t'"remote-branch"$'\t'"$b"$'\t'"PR $st"$'\t'"$b")
    elif [ "$st" = "OPEN" ]; then
      add_skip "$proj" "remote-branch" "origin/$b" "open PR"
    elif [ "$st" = "CLOSED" ]; then
      add_review "$proj" "remote-branch" "origin/$b" "PR closed without merging (unmerged)"
    else
      add_review "$proj" "remote-branch" "origin/$b" "no PR / state unknown ($st)"
    fi
  done < <(git -C "$proj" for-each-ref --format='%(refname)' refs/remotes/origin/task 2>/dev/null)
}

for proj in ${PROJECTS[@]+"${PROJECTS[@]}"}; do
  enumerate_project "$proj"
done

DEL_COUNT=$(( ${#DEL_WORKTREES[@]} + ${#DEL_LBRANCHES[@]} + ${#DEL_RBRANCHES[@]} ))

# ---------- JSON output ----------
if $JSON; then
  emit_arr() {
    local name="$1"; shift
    printf '"%s":[' "$name"
    local first=true row
    for row in "$@"; do
      $first && first=false || printf ','
      IFS=$'\t' read -r p k t r _cmd <<<"$row"
      jq -cn --arg project "$p" --arg kind "$k" --arg target "$t" --arg reason "$r" \
        '{project:$project,kind:$kind,target:$target,reason:$reason}'
    done
    printf ']'
  }
  printf '{'
  emit_arr "worktrees"      ${DEL_WORKTREES[@]+"${DEL_WORKTREES[@]}"}; printf ','
  emit_arr "local_branches" ${DEL_LBRANCHES[@]+"${DEL_LBRANCHES[@]}"}; printf ','
  emit_arr "remote_branches" ${DEL_RBRANCHES[@]+"${DEL_RBRANCHES[@]}"}; printf ','
  emit_arr "needs_review"   ${REVIEW[@]+"${REVIEW[@]}"}; printf ','
  emit_arr "skipped"        ${SKIPPED[@]+"${SKIPPED[@]}"}
  printf '}\n'
  $STAMP && [ -n "$TODAY" ] && printf '%s\n' "$TODAY" > "$STAMP_FILE" 2>/dev/null || true
  exit 0
fi

# ---------- human report ----------
log "atelier-housekeeping ${VERSION}"
sublog "projects scanned: ${#PROJECTS[@]}"
$HAVE_GH || sublog "note: gh not found — PR state unknown; merged-into-base detection only"
echo ""

print_group() {
  local title="$1"; shift
  [ $# -eq 0 ] && return 0
  log "$title ($#):"
  local row
  for row in "$@"; do
    IFS=$'\t' read -r p k t r _cmd <<<"$row"
    sublog "$t"
    sublog "    └ $(basename "$p") · $r"
  done
  echo ""
}

print_group "Worktrees to remove"       ${DEL_WORKTREES[@]+"${DEL_WORKTREES[@]}"}
print_group "Local branches to delete"  ${DEL_LBRANCHES[@]+"${DEL_LBRANCHES[@]}"}
print_group "Remote branches to delete" ${DEL_RBRANCHES[@]+"${DEL_RBRANCHES[@]}"}

if [ ${#REVIEW[@]} -gt 0 ]; then
  log "Needs review — UNMERGED work, NOT auto-removed (${#REVIEW[@]}):"
  for row in "${REVIEW[@]}"; do
    IFS=$'\t' read -r p k t r <<<"$row"
    sublog "$t"
    sublog "    └ $(basename "$p") · $k · $r"
  done
  $INCLUDE_UNMERGED && sublog "(--include-unmerged is set, but these are still only listed — promote them manually)"
  $INCLUDE_UNMERGED || sublog "pass --include-unmerged to review these for removal"
  echo ""
fi

if [ ${#SKIPPED[@]} -gt 0 ]; then
  log "Kept (protected) (${#SKIPPED[@]}):"
  for row in "${SKIPPED[@]}"; do
    IFS=$'\t' read -r p k t r <<<"$row"
    sublog "$t — $(basename "$p") · $r"
  done
  echo ""
fi

# Always stamp a completed enumeration so the daily nudge does not re-fire.
$STAMP && [ -n "$TODAY" ] && printf '%s\n' "$TODAY" > "$STAMP_FILE" 2>/dev/null || true

if [ "$MODE" != "report" ]; then
  for row in ${PRUNE_REFS[@]+"${PRUNE_REFS[@]}"}; do
    IFS=$'\t' read -r p b <<<"$row"
    git -C "$p" update-ref -d "refs/remotes/origin/$b" 2>/dev/null && sublog "origin/$b already deleted (pruned stale tracking ref)"
  done
fi

if [ "$DEL_COUNT" -eq 0 ]; then
  ok "nothing to clean up"
  exit 0
fi

if [ "$MODE" = "report" ]; then
  log "report only — nothing deleted. Re-run without --report to act on the above."
  exit 0
fi

# ---------- confirm ----------
log "$DEL_COUNT item(s) above will be deleted."
if ! $NONINTERACTIVE; then
  if [ ! -t 0 ]; then
    die "non-interactive context (no TTY) but --yes was not given; pass --yes to proceed"
  fi
  printf 'Proceed with deletion? [y/N]: ' >&2
  read -r ans
  case "$ans" in
    y|Y|yes|Yes) sublog "operator confirmed" ;;
    *) warn "operator declined — nothing deleted"; exit 2 ;;
  esac
fi

# ---------- execute ----------
echo ""
log "applying cleanup"

for row in ${DEL_WORKTREES[@]+"${DEL_WORKTREES[@]}"}; do
  IFS=$'\t' read -r p k path r branch <<<"$row"
  if git -C "$p" worktree remove "$path" 2>/dev/null; then
    sublog "removed worktree $path"
  else
    warn "could not remove worktree $path (skipped — may be dirty/locked)"
  fi
done

for row in ${DEL_LBRANCHES[@]+"${DEL_LBRANCHES[@]}"}; do
  IFS=$'\t' read -r p k branch r flag <<<"$row"
  if git -C "$p" branch "$flag" "$branch" >/dev/null 2>&1; then
    sublog "deleted local branch $branch"
  else
    warn "could not delete local branch $branch (skipped)"
  fi
done

for row in ${DEL_RBRANCHES[@]+"${DEL_RBRANCHES[@]}"}; do
  IFS=$'\t' read -r p k branch r ref <<<"$row"
  delete_remote_branch "$p" "$branch"
done

# Prune stale administrative worktree entries.
for proj in ${PROJECTS[@]+"${PROJECTS[@]}"}; do
  git -C "$proj" worktree prune 2>/dev/null || true
done

echo ""
ok "housekeeping complete"
exit 0
