#!/usr/bin/env bash
#
# atelier-automode-sync — keep atelier's managed `autoMode.allow` entries in
# the user-level settings file ($ATELIER_CONFIG_DIR/settings.json) in sync
# with templates/automode.user.json (#456).
#
# Why user level: Claude Code reads `autoMode` only from user settings,
# managed settings and --settings — never from a project's
# .claude/settings.json — so the gate-run classifier rule (#451) has to live
# in the operator's own settings file to have any effect.
#
# READ-ONLY BY DEFAULT. Without --apply the script only prints the diff of
# the managed entries and exits 1 (out of sync) or 0 (in sync). It writes
# ONLY with an explicit --apply, which callers pass only after the operator
# said yes (install.sh y/N prompt, /atelier:update confirmation).
#
# Managed entries carry a marker prefix `[atelier-managed:<id>] `. The merge:
#   - .autoMode.allow absent  -> ["$defaults", <managed...>] (never without
#                                "$defaults": that would replace the built-in
#                                classifier rules)
#   - otherwise               -> marked entries are updated IN PLACE, marked
#                                entries with no current counterpart are
#                                dropped, new managed entries are appended;
#                                every other entry (including "$defaults")
#                                keeps its text and position. No "$defaults"
#                                is added to an array that lacks one.
#   - no other autoMode.* key and no other top-level key is touched.
# The same contract covers the managed entries of the template's environment
# array (an absent array becomes ["$defaults", <managed...>]). The placeholder
# {{registered_projects}} in a managed entry expands to every project in
# $CONFIG_DIR/projects.json with its origin owner/name.
# To take ownership of an entry, delete its `[atelier-managed:...]` marker.
#
# --replace-path OLD=NEW (repeatable, #488): a separate mode for a project that
# moved to a new path. The managed-entry merge is skipped; instead, inside
# .autoMode.{allow,soft_deny,environment} and .permissions.{allow,deny,ask},
# every whole-path occurrence of OLD in a string entry becomes NEW. OLD must not
# be preceded by a path character and must be followed by end of string, `/`,
# whitespace or punctuation, so `/x/atelier-dev2` is never touched by
# OLD=/x/atelier-dev. No other key, entry order or `[atelier-managed:*]` entry
# changes (beyond the path text itself). Same read-only/--apply contract: a
# before/after diff and exit 1 when something would change, 0 when nothing
# would; --apply writes through a temp file + mv. Exit 2 on a malformed
# argument. Not wired into atelier-update: the operator runs it.
#
# Usage:
#   atelier-automode-sync [--apply] [--template <path>] [--config-dir <dir>]
#   atelier-automode-sync --replace-path OLD=NEW [--replace-path ...] [--apply]
#   atelier-automode-sync --help
#
# Exit codes:
#   0  in sync (or applied successfully, or target is invalid JSON — warned
#      and left untouched)
#   1  not in sync (read-only mode; diff printed)
#   2  error (template missing/invalid, jq missing, write failure)

set -euo pipefail

SCRIPT_NAME="$(basename "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(cd -P "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

die() { printf '!!  ERROR: %s\n' "$*" >&2; exit 2; }
warn() { printf '!!  %s\n' "$*" >&2; }

usage() {
  cat <<EOF
${SCRIPT_NAME} — sync atelier-managed autoMode.allow entries into the user-level settings

USAGE:
  ${SCRIPT_NAME} [--apply] [--quiet] [--template <path>] [--config-dir <dir>]
  ${SCRIPT_NAME} --replace-path OLD=NEW [--replace-path OLD=NEW ...] [--apply] [--config-dir <dir>]
  ${SCRIPT_NAME} --help

OPTIONS:
  --apply              Write the merge. Without it the script is read-only.
  --quiet              Omit the read-only footer line (for callers that print their own).
  --template <path>    Managed entries source (default: <plugin>/templates/automode.user.json).
  --config-dir <dir>   Target config dir (default: \$ATELIER_CONFIG_DIR or ~/.claude-work).
  --replace-path OLD=NEW
                       Repeatable. Instead of the managed-entry merge, rewrite whole-path
                       occurrences of OLD to NEW in autoMode.{allow,soft_deny,environment}
                       and permissions.{allow,deny,ask} (a moved project). Read-only
                       without --apply: prints a before/after diff, exit 1 if changes
                       are pending, 0 if none. Relative mentions cannot be detected.
  --help, -h           Show this help.

EXIT CODES:
  0 in sync / applied    1 not in sync (read-only)    2 error
EOF
}

APPLY=false
QUIET=false
declare -a REPLACES=()
TEMPLATE=""
CONFIG_DIR="${ATELIER_CONFIG_DIR:-$HOME/.claude-work}"

while [ $# -gt 0 ]; do
  case "$1" in
    --apply)        APPLY=true; shift ;;
    --quiet)        QUIET=true; shift ;;
    --template)     [ -n "${2:-}" ] || die "--template requires a path"; TEMPLATE="$2"; shift 2 ;;
    --template=*)   TEMPLATE="${1#--template=}"; shift ;;
    --config-dir)   [ -n "${2:-}" ] || die "--config-dir requires a path"; CONFIG_DIR="$2"; shift 2 ;;
    --config-dir=*) CONFIG_DIR="${1#--config-dir=}"; shift ;;
    --replace-path) [ -n "${2:-}" ] || die "--replace-path requires OLD=NEW"; REPLACES+=("$2"); shift 2 ;;
    --replace-path=*) REPLACES+=("${1#--replace-path=}"); shift ;;
    --help|-h)      usage; exit 0 ;;
    *)              die "unknown arg: $1 (run --help for usage)" ;;
  esac
done

command -v jq >/dev/null 2>&1 || die "jq not found in PATH"

if [ ${#REPLACES[@]} -gt 0 ]; then
  PAIRS="[]"
  for r in "${REPLACES[@]}"; do
    case "$r" in
      /*=/*) ;;
      *) die "malformed --replace-path '$r' (expected OLD=NEW, both absolute paths)" ;;
    esac
    old="${r%%=*}"; new="${r#*=}"
    old="${old%/}"; new="${new%/}"
    [ -n "$old" ] && [ -n "$new" ] || die "malformed --replace-path '$r' (empty path)"
    PAIRS="$(jq -c --arg o "$old" --arg n "$new" '. + [{o: $o, n: $n}]' <<<"$PAIRS")"
  done
  TARGET="$CONFIG_DIR/settings.json"
  if [ ! -f "$TARGET" ]; then
    printf 'No %s — nothing to rewrite\n' "$TARGET"
    exit 0
  fi
  if ! jq empty "$TARGET" >/dev/null 2>&1; then
    warn "$TARGET is not valid JSON — leaving alone (operator must repair manually)"
    exit 0
  fi
  # shellcheck disable=SC2016  # jq program, not shell
  RP_DEFS='
    def esc: gsub("(?<c>[\\\\.^$|?*+()\\[\\]{}])"; "\\\(.c)");
    def rewrite($pairs): reduce $pairs[] as $p (.;
      gsub("(?<![A-Za-z0-9_.~/-])" + ($p.o | esc) + "(?![A-Za-z0-9_-])"; $p.n));
    def keys6: [["autoMode","allow"],["autoMode","soft_deny"],["autoMode","environment"],
                ["permissions","allow"],["permissions","deny"],["permissions","ask"]];
  '
  # shellcheck disable=SC2016
  RP_APPLY="$RP_DEFS"'
    reduce keys6[] as $k (.;
      if (getpath($k) | type) == "array"
      then setpath($k; getpath($k) | map(if type == "string" then rewrite($pairs) else . end))
      else . end)'
  # shellcheck disable=SC2016
  RP_DIFF="$RP_DEFS"'
    . as $old | ($old | '"${RP_APPLY#"$RP_DEFS"}"') as $new
    | keys6[] as $k
    | (($old | getpath($k)) // []) as $a | (($new | getpath($k)) // []) as $b
    | range(0; ($a | length)) as $i
    | select($a[$i] != $b[$i])
    | "  \($k | join("."))[\($i)]\n    - \($a[$i])\n    + \($b[$i])"'
  NEWDOC="$(jq --argjson pairs "$PAIRS" "$RP_APPLY" "$TARGET")" || die "could not rewrite $TARGET"
  DIFF="$(jq -r --argjson pairs "$PAIRS" "$RP_DIFF" "$TARGET")" || die "could not diff $TARGET"
  if [ -z "$DIFF" ]; then
    printf 'No whole-path occurrence to replace in %s\n' "$TARGET"
    exit 0
  fi
  printf 'path replacements pending in %s:\n%s\n' "$TARGET" "$DIFF"
  if ! $APPLY; then
    $QUIET || printf 'Read-only: nothing written. Re-run with --apply (after the operator confirms) to write it.\n'
    exit 1
  fi
  TMP="$(mktemp "${TARGET}.atelier.XXXXXX")" || die "could not create temp file next to $TARGET"
  if printf '%s\n' "$NEWDOC" > "$TMP" && mv "$TMP" "$TARGET"; then
    printf 'Applied: path replacements written to %s\n' "$TARGET"
  else
    rm -f "$TMP"
    die "failed to write $TARGET"
  fi
  exit 0
fi

[ -n "$TEMPLATE" ] || TEMPLATE="$SCRIPT_DIR/../templates/automode.user.json"
[ -f "$TEMPLATE" ] || die "template not found: $TEMPLATE"
jq -e '(.autoMode.allow | type) == "array" and ((.autoMode.environment // []) | type) == "array"' "$TEMPLATE" >/dev/null 2>&1 \
  || die "template has no .autoMode.allow array (or a non-array environment): $TEMPLATE"

TARGET="$CONFIG_DIR/settings.json"
EXISTING="{}"
if [ -f "$TARGET" ]; then
  EXISTING="$(cat "$TARGET")"
  if ! printf '%s' "$EXISTING" | jq empty >/dev/null 2>&1; then
    warn "$TARGET is not valid JSON — leaving alone (operator must repair manually)"
    exit 0
  fi
  if ! printf '%s' "$EXISTING" | jq -e '((.autoMode.allow // []) | type == "array") and ((.autoMode.environment // []) | type == "array") and ((.autoMode.soft_deny // []) | type == "array")' >/dev/null 2>&1; then
    warn "$TARGET has a non-array autoMode.allow, autoMode.environment or autoMode.soft_deny — leaving alone"
    exit 0
  fi
fi

# {{registered_projects}}: every project in projects.json as "<path> (origin
# <owner>/<name>, <public|private|visibility unknown>)"; visibility comes from
# `gh repo view` and degrades to "visibility unknown" when gh is missing or
# fails; a failed lookup never downgrades a visibility the previously written
# entry already records (offline or unauthenticated runs keep the known value).
# The remote read with `git -C <path> remote get-url origin`;
# a path that is gone or has no origin is listed without the remote.
PRIOR_TRUSTED="$(printf '%s' "$EXISTING" | jq -r '(.autoMode.environment // [])[] | select(type == "string" and startswith("[atelier-managed:trusted-repos]"))' 2>/dev/null || true)"

repo_visibility() {
  local v="" prior=""
  if command -v gh >/dev/null 2>&1; then
    v="$(gh repo view "$1" --json visibility --jq '.visibility' 2>/dev/null | tr '[:upper:]' '[:lower:]' || true)"
  fi
  case "$v" in
    public|private) printf '%s' "$v" ;;
    internal) printf 'private' ;;
    *)
      prior="$(printf '%s' "$PRIOR_TRUSTED" | grep -oF "origin $1, public)" 2>/dev/null || true)"
      [ -n "$prior" ] && { printf 'public'; return; }
      prior="$(printf '%s' "$PRIOR_TRUSTED" | grep -oF "origin $1, private)" 2>/dev/null || true)"
      [ -n "$prior" ] && { printf 'private'; return; }
      printf 'visibility unknown' ;;
  esac
}

render_registered_projects() {
  local pf="$CONFIG_DIR/projects.json" p url slug out="" item
  if [ -f "$pf" ] && jq empty "$pf" >/dev/null 2>&1; then
    while IFS= read -r p; do
      [ -n "$p" ] || continue
      url=""; slug=""
      [ -d "$p" ] && url="$(git -C "$p" remote get-url origin 2>/dev/null || true)"
      if [ -n "$url" ]; then
        slug="$(printf '%s' "${url%.git}" | sed -E 's#^.*[:/]([^:/]+/[^/]+)$#\1#')"
      fi
      item="$p"
      [ -n "$slug" ] && item="$p (origin $slug, $(repo_visibility "$slug"))"
      out="${out:+$out; }$item"
    done < <(jq -r '.projects // {} | keys[]' "$pf")
  fi
  [ -n "$out" ] || out="(no project registered yet)"
  printf '%s' "$out"
}

REGISTERED="$(render_registered_projects)"
# gsub's replacement is literal text (no backreferences), so paths are safe.
# shellcheck disable=SC2016  # jq program, not shell
MANAGED="$(jq -c --arg r "$REGISTERED" '
  .autoMode | {allow: .allow, environment: (.environment // []), soft_deny: (.soft_deny // [])}
  | map_values(map(gsub("\\{\\{registered_projects\\}\\}"; $r)))' "$TEMPLATE")"

# shellcheck disable=SC2016  # jq program, not shell
JQ_DEFS='
  def ismanaged: type == "string" and startswith("[atelier-managed:");
  def mid: sub("^\\[atelier-managed:(?<id>[^\\]]*)\\].*"; "\(.id)");
  def keys2: ["allow", "environment", "soft_deny"];
'

# shellcheck disable=SC2016
JQ_MERGE="$JQ_DEFS"'
  def mergekey($k):
    ($m[$k] // []) as $mk
    | ($mk | map(select(ismanaged)) | map({key: mid, value: .}) | from_entries) as $mm
    | (.autoMode[$k] // null) as $cur
    | if $cur == null then
        (if ($mk | length) == 0 then . else .autoMode = ((.autoMode // {}) | .[$k] = (["$defaults"] + $mk)) end)
      else
        ($cur | map(select(ismanaged) | mid)) as $have
        | .autoMode[$k] = (
            ($cur | map(if ismanaged then ($mm[mid] // empty) else . end))
            + ($mk | map(select(ismanaged and ((mid as $i | $have | index($i)) == null))))
          )
      end;
  reduce keys2[] as $k (.; mergekey($k))'

MERGED="$(printf '%s' "$EXISTING" | jq --argjson m "$MANAGED" "$JQ_MERGE")"

if [ "$(printf '%s' "$EXISTING" | jq -S -c .)" = "$(printf '%s' "$MERGED" | jq -S -c .)" ] && [ -f "$TARGET" ]; then
  printf 'autoMode managed entries already in sync in %s\n' "$TARGET"
  exit 0
fi

# Human-readable diff of the managed entries (added / replaced / removed).
# shellcheck disable=SC2016
DIFF_PROG="$JQ_DEFS"'
  def entries: map(select(ismanaged)) | map({key: mid, value: .}) | from_entries;
  def body: sub("^\\[atelier-managed:[^\\]]*\\] *"; "");
  ($old.autoMode[$k] // [] | entries) as $c | ($m[$k] // [] | entries) as $w
  | ([$w | to_entries[] | select($c[.key] == null) | "+ [" + .key + "] " + (.value | body)]
   + [$w | to_entries[] | select($c[.key] != null and $c[.key] != .value) | "~ [" + .key + "] " + (.value | body)]
   + [$c | to_entries[] | select($w[.key] == null) | "- [" + .key + "]"])
  | .[]'
for k in allow environment soft_deny; do
  K_DIFF="$(jq -nr --arg k "$k" --argjson m "$MANAGED" --argjson old "$EXISTING" "$DIFF_PROG")"
  if [ -n "$K_DIFF" ]; then
    printf 'autoMode.%s managed-entry changes for %s:\n' "$k" "$TARGET"
    printf '%s\n' "$K_DIFF" | sed 's/^/  /'
  fi
done

if ! $APPLY; then
  $QUIET || printf 'Read-only: nothing written. Re-run with --apply (after the operator confirms) to write it.\n'
  exit 1
fi

mkdir -p "$CONFIG_DIR"
TMP="$(mktemp "${TARGET}.atelier.XXXXXX")" || die "could not create temp file next to $TARGET"
if printf '%s\n' "$MERGED" > "$TMP" && mv "$TMP" "$TARGET"; then
  printf 'Applied: managed autoMode entries written to %s\n' "$TARGET"
else
  rm -f "$TMP"
  die "failed to write $TARGET"
fi
exit 0
