#!/usr/bin/env bash
#
# atelier-cpu-slot — pass-through kept for call-shape compatibility (#584).
#
# There is no CPU limit on this machine: no lock, no queue, no wait. The script
# exists only so `cpu-slot <cmd>` / `atelier-cpu-slot <cmd>` keep working (and
# the ~/.local/bin symlink never dangles). All CPU_SLOT_* variables and
# cpu-slot.json are ignored; /tmp/cpu-slot.* is never created or read.
#
# Usage:
#   atelier-cpu-slot <cmd> [args...]     exec <cmd> directly
#   atelier-cpu-slot --status            prints "free (no CPU limit)"
#   atelier-cpu-slot --wait [--timeout S] returns 0 immediately
#   atelier-cpu-slot acquire|release ... no-op, exit 0
#   atelier-cpu-slot --help

set -u

case "${1:-}" in
  "")
    echo "usage: atelier-cpu-slot <cmd> [args...] | --status | --wait [--timeout S] | acquire | release | --help" >&2
    exit 2
    ;;
  -h|--help)
    sed -n '3,15p' "$0" | sed 's/^# \{0,1\}//'
    exit 0
    ;;
  --status)
    echo "free (no CPU limit)"
    exit 0
    ;;
  --wait|acquire|release)
    exit 0
    ;;
esac

exec "$@"
