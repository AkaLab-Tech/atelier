#!/usr/bin/env bash
#
# atelier-memory — persistent, typed, append-only project memory (#618, PLAN.md §17).
#
# Usage:
#   atelier-memory add <type> --project P --source S --title T [--body B|-] [--quote Q]
#                      [--ref R]... [--supersedes ID] [--by WHO]
#   atelier-memory supersede <id> --source S --title T [--body B|-] [--quote Q] [--ref R]...
#                      [--project P] [--type TYPE] [--by WHO]
#   atelier-memory close <id> --by <id|reason>
#   atelier-memory list [--project P] [--type T] [--open] [--all]
#   atelier-memory show <id>
#   atelier-memory search <fts5 query> [--project P]
#   atelier-memory brief --project P
#   atelier-memory path
#
# Types: request question decision fact held digest (ids R- Q- D- F- H- G-).
# Sources: operator-verbatim (needs --quote), agent-inferred, board-derived.
# Project: a directory (a task worktree resolves to its main checkout), a registered
# project name, or '*' for global. Refs: issue:o/r#N pr:o/r#N record:D-41 file:<path>.
#
# Store: $ATELIER_CONFIG_DIR/atelier/memory.db (default ~/.claude-work/atelier/memory.db),
# SQLite WAL, created lazily on the first write (never by a read). Records are never
# overwritten or deleted (enforced by triggers): supersede links old -> new atomically.
# Values containing secrets are refused (exit 3): store a reference instead.
# list hides superseded and closed records unless --all. brief prints a bounded block
# for SessionStart and nothing when there is no DB or no records.
#
# Exit codes: 0 ok, 2 usage or environment error, 3 refused.

set -u

usage() { sed -n '2,31p' "$0" | sed 's/^# \{0,1\}//'; }

CFG="${ATELIER_CONFIG_DIR:-$HOME/.claude-work}"
DB="$CFG/atelier/memory.db"
LATEST_SCHEMA=1

die() { echo "atelier-memory: $*" >&2; exit 2; }
refuse() { echo "atelier-memory: refused — $*" >&2; exit 3; }

case "${1:-}" in -h|--help) usage; exit 0 ;; esac
[ $# -ge 1 ] || { usage >&2; exit 2; }
sub="$1"; shift

if [ "$sub" = path ]; then printf '%s\n' "$DB"; exit 0; fi

command -v sqlite3 >/dev/null 2>&1 || die "sqlite3 is required"

# ---------- SQL helpers ----------

hexof() { printf '%s' "$1" | xxd -p | tr -d '\n'; }
# Every user value enters SQL as a hex blob literal; never interpolated.
lit() { printf "CAST(X'%s' AS TEXT)" "$(hexof "$1")"; }
dec() { printf '%s' "$1" | xxd -r -p; }

# SQL comes in on stdin (no argv size limit).
sqlrun() { sqlite3 -bail -cmd '.timeout 5000' "$DB"; }
sqlro() { sqlite3 -readonly -bail -cmd '.timeout 5000' "$DB"; }

user_version() { printf 'PRAGMA user_version;' | sqlite3 "$DB" 2>/dev/null; }

SCHEMA_V1="
CREATE TABLE IF NOT EXISTS records (
  id            TEXT NOT NULL UNIQUE,
  type          TEXT NOT NULL CHECK (type IN ('request','question','decision','fact','held','digest')),
  project       TEXT NOT NULL,
  source        TEXT NOT NULL CHECK (source IN ('operator-verbatim','agent-inferred','board-derived')),
  title         TEXT NOT NULL,
  body          TEXT NOT NULL DEFAULT '',
  quote         TEXT,
  refs          TEXT NOT NULL DEFAULT '[]',
  created_at    TEXT NOT NULL,
  created_by    TEXT NOT NULL,
  superseded_by TEXT,
  superseded_at TEXT,
  closed_at     TEXT,
  closed_by     TEXT,
  CHECK (source <> 'operator-verbatim' OR length(trim(coalesce(quote,''))) > 0)
);
CREATE INDEX IF NOT EXISTS records_project_type ON records(project, type);
CREATE VIRTUAL TABLE IF NOT EXISTS records_fts USING fts5(title, body, quote, content='records', content_rowid='rowid');
CREATE TRIGGER IF NOT EXISTS records_ai AFTER INSERT ON records BEGIN
  INSERT INTO records_fts(rowid, title, body, quote) VALUES (new.rowid, new.title, new.body, coalesce(new.quote,''));
END;
CREATE TRIGGER IF NOT EXISTS records_immutable BEFORE UPDATE ON records
WHEN NEW.rowid IS NOT OLD.rowid OR NEW.id IS NOT OLD.id OR NEW.type IS NOT OLD.type
  OR NEW.project IS NOT OLD.project OR NEW.source IS NOT OLD.source OR NEW.title IS NOT OLD.title
  OR NEW.body IS NOT OLD.body OR NEW.quote IS NOT OLD.quote OR NEW.refs IS NOT OLD.refs
  OR NEW.created_at IS NOT OLD.created_at OR NEW.created_by IS NOT OLD.created_by
  OR (OLD.superseded_by IS NOT NULL AND NEW.superseded_by IS NOT OLD.superseded_by)
  OR (OLD.superseded_at IS NOT NULL AND NEW.superseded_at IS NOT OLD.superseded_at)
  OR (OLD.closed_at IS NOT NULL AND NEW.closed_at IS NOT OLD.closed_at)
  OR (OLD.closed_by IS NOT NULL AND NEW.closed_by IS NOT OLD.closed_by)
BEGIN SELECT RAISE(ABORT, 'records are immutable: supersede instead of editing'); END;
CREATE TRIGGER IF NOT EXISTS records_no_delete BEFORE DELETE ON records
BEGIN SELECT RAISE(ABORT, 'records are never deleted: supersede or close instead'); END;
"

# Ordered migrations: each step runs once, in order, from the stored user_version.
ensure_db() {
  mkdir -p "$(dirname "$DB")" || die "cannot create $(dirname "$DB")"
  local v
  v="$(user_version)"; v="${v:-0}"
  [ "$v" -ge "$LATEST_SCHEMA" ] && return 0
  printf 'PRAGMA journal_mode=WAL;' | sqlite3 -cmd '.timeout 5000' "$DB" >/dev/null 2>&1
  if [ "$v" -lt 1 ]; then
    printf 'BEGIN IMMEDIATE;\n%s\nPRAGMA user_version=1;\nCOMMIT;\n' "$SCHEMA_V1" | sqlrun >/dev/null \
      || die "schema init failed"
  fi
}

# ---------- project resolution ----------

resolve_project() {
  local p="$1" d common name
  [ "$p" = '*' ] && { printf '*'; return 0; }
  if [ ! -d "$p" ] && command -v jq >/dev/null 2>&1 && [ -f "$CFG/projects.json" ]; then
    name="$(jq -r --arg n "$p" '[.projects // {} | to_entries[] | select(.value.name == $n) | .key][0] // empty' "$CFG/projects.json" 2>/dev/null)"
    [ -n "$name" ] && p="$name"
  fi
  [ -d "$p" ] || die "unknown project (not a directory or registered name): $p"
  d="$(cd "$p" && pwd -P)"
  common="$(git -C "$d" rev-parse --path-format=absolute --git-common-dir 2>/dev/null || true)"
  if [ -n "$common" ]; then
    case "$common" in
      */.git) d="$(cd "${common%/.git}" 2>/dev/null && pwd -P || printf '%s' "$d")" ;;
    esac
  fi
  printf '%s' "$d"
}

project_label() {
  local p="$1" n=""
  [ "$p" = '*' ] && { printf 'global'; return; }
  if command -v jq >/dev/null 2>&1 && [ -f "$CFG/projects.json" ]; then
    n="$(jq -r --arg p "$p" '.projects[$p].name // empty' "$CFG/projects.json" 2>/dev/null)"
  fi
  printf '%s' "${n:-$(basename "$p")}"
}

# ---------- secret refusal ----------

patterns_file() {
  local root="${CLAUDE_PLUGIN_ROOT:-}" self cache
  if [ -z "$root" ] || [ ! -f "$root/hooks/patterns/scan-edit-write.json" ]; then
    self="$(readlink "$0" 2>/dev/null || printf '%s' "$0")"
    root="$(cd -P "$(dirname "$self")/.." 2>/dev/null && pwd)"
  fi
  if [ ! -f "$root/hooks/patterns/scan-edit-write.json" ] && [ -f "$CFG/plugins/installed_plugins.json" ]; then
    cache="$(jq -r '.plugins["atelier@akalab-tech"][0].installPath // empty' "$CFG/plugins/installed_plugins.json" 2>/dev/null)"
    root="${cache/#\~/$HOME}"
  fi
  [ -f "$root/hooks/patterns/scan-edit-write.json" ] || return 1
  printf '%s' "$root/hooks/patterns/scan-edit-write.json"
}

# Same matcher shape as hooks/scan-edit-write.sh, restricted to the blocking secret
# patterns (the catalogue's code-injection patterns are irrelevant to memory text).
check_secrets() {
  local field="$1" content="$2" pf pat_json name regex ci
  [ -n "$content" ] || return 0
  command -v jq >/dev/null 2>&1 || die "jq is required"
  pf="$(patterns_file)" || die "secret catalogue not found (hooks/patterns/scan-edit-write.json); refusing to write unscanned"
  while IFS= read -r pat_json; do
    [ -n "$pat_json" ] || continue
    name="$(printf '%s' "$pat_json" | jq -r '.name')"
    regex="$(printf '%s' "$pat_json" | jq -r '.pattern // empty')"
    ci="$(printf '%s' "$pat_json" | jq -r '.case_insensitive // false')"
    [ -n "$regex" ] || continue
    local flags=(-E); [ "$ci" = true ] && flags+=(-i)
    if printf '%s' "$content" | grep "${flags[@]}" -q -- "$regex" 2>/dev/null; then
      refuse "$field matches secret pattern '$name'; nothing was written. Store a reference instead (e.g. file:.env.local or the variable name), never the value."
    fi
  done < <(jq -c '.patterns[]? | select(.action == "block" and .match_type == "regex" and (.name | test("secret")))' "$pf")
}

# ---------- argument parsing ----------

project=""; source_=""; title=""; body=""; quote=""; supersedes=""; by=""; type_filter=""
open_only=0; all=0; refs=(); positional=()
body_set=0

parse_opts() {
  while [ $# -gt 0 ]; do
    case "$1" in
      --project)    project="${2-}"; shift 2 || die "--project needs a value" ;;
      --source)     source_="${2-}"; shift 2 || die "--source needs a value" ;;
      --title)      title="${2-}"; shift 2 || die "--title needs a value" ;;
      --body)       [ $# -ge 2 ] || die "--body needs a value"; body="$2"; body_set=1; shift 2 ;;
      --quote)      quote="${2-}"; shift 2 || die "--quote needs a value" ;;
      --ref)        [ $# -ge 2 ] || die "--ref needs a value"; refs+=("$2"); shift 2 ;;
      --supersedes) supersedes="${2-}"; shift 2 || die "--supersedes needs a value" ;;
      --by)         by="${2-}"; shift 2 || die "--by needs a value" ;;
      --type)       type_filter="${2-}"; shift 2 || die "--type needs a value" ;;
      --open)       open_only=1; shift ;;
      --all)        all=1; shift ;;
      -h|--help)    usage; exit 0 ;;
      --)           shift; positional+=("$@"); break ;;
      -*)           die "unknown argument: $1" ;;
      *)            positional+=("$1"); shift ;;
    esac
  done
  if [ "$body_set" = 1 ] && [ "$body" = "-" ]; then
    body="$(cat; printf x)"; body="${body%x}"
  fi
}

valid_type() { case "$1" in request|question|decision|fact|held|digest) return 0 ;; *) return 1 ;; esac; }
prefix_of() {
  case "$1" in request) echo R ;; question) echo Q ;; decision) echo D ;; fact) echo F ;; held) echo H ;; digest) echo G ;; esac
}
valid_id() { case "$1" in [RQDFHG]-[0-9]*) case "${1#?-}" in *[!0-9]*) return 1 ;; esac; return 0 ;; *) return 1 ;; esac; }

refs_json() {
  if [ "${#refs[@]}" -eq 0 ]; then printf '[]'; return; fi
  local r
  for r in "${refs[@]}"; do
    case "$r" in
      issue:*|pr:*|record:*|file:*) ;;
      *) die "bad --ref '$r' (expected issue:o/r#N, pr:o/r#N, record:ID or file:PATH)" ;;
    esac
  done
  jq -nc '$ARGS.positional' --args "${refs[@]}"
}

# ---------- write path ----------

# do_add <type> <project-resolved> ; uses globals source_ title body quote refs supersedes by
do_add() {
  local type="$1" proj="$2" refj actor sql out pfx
  valid_type "$type" || die "unknown type '$type' (request question decision fact held digest)"
  case "$source_" in
    operator-verbatim|agent-inferred|board-derived) ;;
    *) die "--source must be operator-verbatim, agent-inferred or board-derived" ;;
  esac
  [ -n "$title" ] || die "--title is required"
  if [ "$source_" = operator-verbatim ] && [ -z "$(printf '%s' "$quote" | tr -d '[:space:]')" ]; then
    refuse "source operator-verbatim requires a non-empty --quote (the operator's exact words)"
  fi
  command -v jq >/dev/null 2>&1 || die "jq is required"
  refj="$(refs_json)" || exit 2
  check_secrets title "$title"
  check_secrets body "$body"
  check_secrets quote "$quote"
  check_secrets refs "$refj"
  [ -z "$supersedes" ] || valid_id "$supersedes" || die "bad record id: $supersedes"
  actor="${by:-${ATELIER_MEMORY_ACTOR:-agent}}"
  pfx="$(prefix_of "$type")"
  ensure_db
  sql="BEGIN IMMEDIATE;
INSERT INTO records (id,type,project,source,title,body,quote,refs,created_at,created_by)
VALUES ((SELECT '$pfx-' || (COALESCE(MAX(CAST(SUBSTR(id,3) AS INTEGER)),0)+1) FROM records WHERE type='$type'),
  '$type', $(lit "$proj"), '$source_', $(lit "$title"), $(lit "$body"),
  $( [ -n "$quote" ] && lit "$quote" || printf NULL ), $(lit "$refj"),
  strftime('%Y-%m-%dT%H:%M:%SZ','now'), $(lit "$actor"));
CREATE TEMP TABLE new_id AS SELECT id FROM records WHERE rowid = last_insert_rowid();"
  if [ -n "$supersedes" ]; then
    sql="$sql
UPDATE records SET superseded_by=(SELECT id FROM new_id), superseded_at=strftime('%Y-%m-%dT%H:%M:%SZ','now')
 WHERE id=$(lit "$supersedes") AND superseded_by IS NULL;
CREATE TEMP TABLE guard(ok INTEGER CHECK (ok=1));
INSERT INTO guard VALUES (changes());"
  fi
  sql="$sql
SELECT 'ID=' || id FROM new_id;
COMMIT;"
  out="$(printf '%s\n' "$sql" | sqlrun 2>&1)" || {
    case "$out" in
      *"CHECK constraint failed"*) refuse "cannot supersede $supersedes: unknown or already superseded" ;;
      *) die "write failed: $out" ;;
    esac
  }
  printf '%s\n' "$out" | sed -n 's/^ID=//p'
}

cmd_add() {
  parse_opts "$@"
  [ "${#positional[@]}" -eq 1 ] || die "usage: add <type> --project P --source S --title T ..."
  [ -n "$project" ] || die "--project is required (a directory, a project name, or '*')"
  rp="$(resolve_project "$project")" || exit 2
  do_add "${positional[0]}" "$rp"
}

fetch_old() { # <id> -> sets old_type old_project (from a read-only query)
  local row
  [ -f "$DB" ] || refuse "unknown record $1"
  row="$(printf "SELECT type || '|' || hex(project) FROM records WHERE id=%s;" "$(lit "$1")" | sqlro 2>/dev/null)"
  [ -n "$row" ] || refuse "unknown record $1"
  old_type="${row%%|*}"; old_project="$(dec "${row#*|}")"
}

cmd_supersede() {
  parse_opts "$@"
  [ "${#positional[@]}" -eq 1 ] || die "usage: supersede <id> --source S --title T ..."
  valid_id "${positional[0]}" || die "bad record id: ${positional[0]}"
  local old_type old_project proj type
  fetch_old "${positional[0]}"
  type="${type_filter:-$old_type}"
  proj="$old_project"
  [ -z "$project" ] || proj="$(resolve_project "$project")" || exit 2
  supersedes="${positional[0]}"
  do_add "$type" "$proj"
}

cmd_close() {
  parse_opts "$@"
  [ "${#positional[@]}" -eq 1 ] || die "usage: close <id> --by <id|reason>"
  valid_id "${positional[0]}" || die "bad record id: ${positional[0]}"
  [ -n "$by" ] || die "--by is required (a record id or a reason)"
  check_secrets by "$by"
  [ -f "$DB" ] || refuse "unknown record ${positional[0]}"
  local out
  out="$(printf "BEGIN IMMEDIATE;
UPDATE records SET closed_at=strftime('%%Y-%%m-%%dT%%H:%%M:%%SZ','now'), closed_by=%s
 WHERE id=%s AND closed_at IS NULL AND superseded_by IS NULL;
SELECT 'N=' || changes();
COMMIT;\n" "$(lit "$by")" "$(lit "${positional[0]}")" | sqlrun 2>&1)" || die "close failed: $out"
  [ "$(printf '%s\n' "$out" | sed -n 's/^N=//p')" = 1 ] \
    || refuse "${positional[0]} is unknown, already closed or superseded"
  echo "closed ${positional[0]}"
}

# ---------- read path ----------

NL1="replace(replace(title, char(10), ' '), char(13), ' ')"

scope_sql() { # <resolved project> -> project filter fragment
  if [ "$1" = '*' ]; then printf "project='*'"; else printf "project IN (%s,'*')" "$(lit "$1")"; fi
}

cmd_list() {
  parse_opts "$@"
  [ -f "$DB" ] || exit 0
  local where="1=1"
  if [ -n "$project" ]; then rp="$(resolve_project "$project")" || exit 2; where="$where AND project=$(lit "$rp")"; fi
  if [ -n "$type_filter" ]; then
    valid_type "$type_filter" || die "unknown type '$type_filter'"
    where="$where AND type='$type_filter'"
  fi
  if [ "$all" = 0 ]; then where="$where AND superseded_by IS NULL AND closed_at IS NULL"; fi
  [ "$open_only" = 0 ] || where="$where AND superseded_by IS NULL AND closed_at IS NULL"
  printf "SELECT id || char(9) || type || char(9) || substr(created_at,1,10) || char(9) || source || char(9) ||
 CASE WHEN superseded_by IS NOT NULL THEN 'superseded-by:' || superseded_by WHEN closed_at IS NOT NULL THEN 'closed' ELSE 'open' END
 || char(9) || substr(%s,1,120)
 FROM records WHERE %s ORDER BY created_at, rowid;" "$NL1" "$where" | sqlro
}

cmd_show() {
  parse_opts "$@"
  [ "${#positional[@]}" -eq 1 ] || die "usage: show <id>"
  valid_id "${positional[0]}" || die "bad record id: ${positional[0]}"
  [ -f "$DB" ] || refuse "unknown record ${positional[0]}"
  local row type proj src ttl bdy qte refj cat cby sby sat clat clby
  row="$(printf "SELECT type||'|'||hex(project)||'|'||source||'|'||hex(title)||'|'||hex(body)||'|'||hex(coalesce(quote,''))||'|'||hex(refs)||'|'||created_at||'|'||hex(created_by)||'|'||coalesce(superseded_by,'')||'|'||coalesce(superseded_at,'')||'|'||coalesce(closed_at,'')||'|'||hex(coalesce(closed_by,''))
 FROM records WHERE id=%s;" "$(lit "${positional[0]}")" | sqlro 2>/dev/null)"
  [ -n "$row" ] || refuse "unknown record ${positional[0]}"
  IFS='|' read -r type proj src ttl bdy qte refj cat cby sby sat clat clby <<<"$row"
  proj="$(dec "$proj")"
  echo "id: ${positional[0]}"
  echo "type: $type"
  echo "project: $proj ($(project_label "$proj"))"
  echo "source: $src"
  printf 'created: %s by %s\n' "$cat" "$(dec "$cby")"
  if [ -n "$sby" ]; then echo "status: superseded by $sby at $sat"
  elif [ -n "$clat" ]; then printf 'status: closed at %s by %s\n' "$clat" "$(dec "$clby")"
  else echo "status: open"; fi
  printf 'title: '; dec "$ttl"; echo
  [ -z "$qte" ] || { printf 'quote: '; dec "$qte"; echo; }
  printf 'refs: '; dec "$refj"; echo
  echo "body:"; dec "$bdy"; echo
  # Supersede chain: walk predecessors, then successors.
  local chain="${positional[0]}" cur="${positional[0]}" n=0 nxt
  while [ $n -lt 100 ]; do
    nxt="$(printf "SELECT id FROM records WHERE superseded_by=%s;" "$(lit "$cur")" | sqlro 2>/dev/null | head -1)"
    [ -n "$nxt" ] || break
    chain="$nxt -> $chain"; cur="$nxt"; n=$((n+1))
  done
  cur="${positional[0]}"; n=0
  while [ $n -lt 100 ]; do
    nxt="$(printf "SELECT coalesce(superseded_by,'') FROM records WHERE id=%s;" "$(lit "$cur")" | sqlro 2>/dev/null)"
    [ -n "$nxt" ] || break
    chain="$chain -> $nxt"; cur="$nxt"; n=$((n+1))
  done
  echo "chain: $chain"
}

cmd_search() {
  parse_opts "$@"
  [ "${#positional[@]}" -ge 1 ] || die "usage: search <fts5 query> [--project P]"
  [ -f "$DB" ] || exit 0
  local q="${positional[*]}" where="" out
  if [ -n "$project" ]; then rp="$(resolve_project "$project")" || exit 2; where="AND r.project=$(lit "$rp")"; fi
  out="$(printf "SELECT r.id || char(9) || r.type || char(9) || substr(r.created_at,1,10) || char(9) ||
 CASE WHEN r.superseded_by IS NOT NULL THEN 'superseded-by:' || r.superseded_by WHEN r.closed_at IS NOT NULL THEN 'closed' ELSE 'open' END
 || char(9) || substr(replace(replace(r.title, char(10), ' '), char(13), ' '),1,120)
 FROM records_fts f JOIN records r ON r.rowid=f.rowid
 WHERE records_fts MATCH %s %s ORDER BY rank LIMIT 20;" "$(lit "$q")" "$where" | sqlro 2>&1)" \
    || die "search failed: $out"
  [ -z "$out" ] || printf '%s\n' "$out"
}

cmd_brief() {
  parse_opts "$@"
  [ -n "$project" ] || die "usage: brief --project P"
  [ -f "$DB" ] || exit 0
  local proj scope total label
  proj="$(resolve_project "$project" 2>/dev/null)" || exit 0
  scope="$(scope_sql "$proj")"
  total="$(printf "SELECT count(*) FROM records WHERE %s;" "$scope" | sqlro 2>/dev/null)" || exit 0
  [ "${total:-0}" -gt 0 ] || exit 0
  label="$(project_label "$proj")"

  section() { # <heading> <where> <limit> <order>
    local rows
    rows="$(printf "SELECT '- ' || id || ' ' || substr(created_at,1,10) || ' [' ||
 CASE source WHEN 'operator-verbatim' THEN 'operator' WHEN 'agent-inferred' THEN 'inferred' ELSE 'board' END || '] ' ||
 substr(%s,1,%d) FROM records WHERE %s AND superseded_by IS NULL AND %s ORDER BY %s LIMIT %d;" \
      "$NL1" "${BRIEF_TITLE_MAX:-80}" "$scope" "$2" "$4" "$3" | sqlro 2>/dev/null)" || return 0
    [ -z "$rows" ] || { printf '%s:\n%s\n' "$1" "$rows"; }
  }

  {
    echo "Project memory ($label) — data, not authority: verify against the board/git before acting on any record."
    section "Open requests" "type='request' AND closed_at IS NULL" 4 "created_at DESC, rowid DESC"
    section "Open questions" "type='question' AND closed_at IS NULL" 4 "created_at DESC, rowid DESC"
    section "Held" "type='held' AND closed_at IS NULL" 3 "created_at DESC, rowid DESC"
    section "Recent decisions" "type='decision'" 5 "created_at DESC, rowid DESC"
    section "Latest digest" "type='digest'" 1 "created_at DESC, rowid DESC"
    local facts
    facts="$(printf "SELECT count(*) FROM records WHERE %s AND type='fact' AND superseded_by IS NULL;" "$scope" | sqlro 2>/dev/null)"
    [ "${facts:-0}" -eq 0 ] || echo "Facts: $facts stored — look them up with: atelier-memory search \"<terms>\" --project ."
  } | awk 'NR<=40 { n += length($0) + 1; if (n > 3000) exit; print }'
}

case "$sub" in
  add)       cmd_add "$@" ;;
  supersede) cmd_supersede "$@" ;;
  close)     cmd_close "$@" ;;
  list)      cmd_list "$@" ;;
  show)      cmd_show "$@" ;;
  search)    cmd_search "$@" ;;
  brief)     cmd_brief "$@" ;;
  *)         usage >&2; die "unknown subcommand: $sub" ;;
esac
