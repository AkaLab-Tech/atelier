#!/usr/bin/env bash
#
# atelier-pr-size-check — evaluate whether a PR's diff exceeds the
# project's per-PR size budget, AFTER exempting auto-generated /
# test / migration files that do not contribute to reviewability.
#
# Two evaluation modes:
#   --branch <name>   compare <name>...<base> locally (no network).
#                     Use this from pr-author / pr-flow BEFORE pushing.
#   --pr <NN>         fetch the PR's file list via `gh pr view`.
#                     Use this from reviewer / auto-merge AFTER the PR exists.
#
# The script is the executable form of PLAN.md §6's "PR size" guardrail.
# It is the single source of truth — agents and skills call it instead
# of inlining their own jq + glob logic, so the rule can be evolved in
# one place.
#
# Threshold rule: a PR is OVERSIZE when BOTH limits are exceeded
# (`additions+deletions > maxLines` AND `changedFiles > maxFiles`).
# Either alone is fine — a tightly-scoped diff that grows long, or a
# broad refactor that stays small, both fit the operator's mental model
# of a reviewable change.
#
# Defaults (override via <project-root>/.atelier.json):
#   prSize.maxLines = 200
#   prSize.maxFiles = 10
#   prSize.exempt   = (see DEFAULT_EXEMPT below; entries EXTEND the defaults)
#   prSize.maxExemptOnlyLines = 400 (cap for PRs whose changes are all exempt)
#
# Exit codes:
#   0  within limits (or AND-fail-but-only-one-side-exceeds)
#   1  oversize (BOTH limits exceeded post-exemptions, or an exempt-only
#      PR above prSize.maxExemptOnlyLines)
#   2  error (missing deps, bad args, unreachable ref or PR, failed diff,
#      truncated gh file list, malformed .atelier.json). Never reports OK
#      after a failure.

set -euo pipefail
IFS=$'\n\t'

VERSION="0.1.0"
SCRIPT_NAME="$(basename "${BASH_SOURCE[0]}")"

# ---------- logging ----------
die() { printf '!!  ERROR: %s\n' "$*" >&2; exit 2; }

# ---------- defaults ----------
# Default exemption globs. Patterns are matched against the diff's
# file paths (relative to the project root) using bash's `case ... esac`
# with extended globbing — see path_is_exempt() below.
#
# Keep this list conservative. Adding a glob here changes the
# reviewability calculus for every atelier project that doesn't override.
DEFAULT_MAX_LINES=200
DEFAULT_MAX_FILES=10
DEFAULT_MAX_EXEMPT_ONLY_LINES=400
DEFAULT_EXEMPT=(
  # Root tracking files (bare names, root only)
  "ROADMAP.md"
  "IN_PROGRESS.md"
  "HISTORY.md"
  # Lockfiles + manifest helpers (operator never hand-edits these)
  "pnpm-lock.yaml"
  "package-lock.json"
  "yarn.lock"
  # Auto-generated artifacts
  "**/*.snap"
  "**/*.generated.*"
  "**/generated/**"
  "**/__generated__/**"
  # Test code (encouraged; not part of reviewability budget)
  "**/*.test.*"
  "**/*.spec.*"
  "**/__tests__/**"
  "**/tests/**"
  "**/e2e/**"
  "**/playwright/**"
  "**/cypress/**"
  # DB migrations (atomic schema changes)
  "**/migrations/**"
  "**/*.sql"
)

# ---------- usage ----------
usage() {
  cat <<EOF
${SCRIPT_NAME} ${VERSION}

Evaluate whether a PR's diff exceeds the project's per-PR size budget,
after exempting auto-generated / test / migration files.

USAGE:
  ${SCRIPT_NAME} --branch <branch> [--base <ref>] [--project <root>]
  ${SCRIPT_NAME} --pr <NN> [--repo <owner/name>] [--project <root>]
  ${SCRIPT_NAME} --help

OPTIONS:
  --branch <name>     Local mode. Diff <name> against <base> (default: main).
                      The base resolves to origin/<base> when it exists
                      (else local <base>, else exit 2). Offline: no fetch.
                      Use BEFORE pushing (pr-author / pr-flow step 3).
  --base <ref>        Base ref for --branch mode. Default: main.
  --pr <NN>           Remote mode. Fetch the PR's file list via 'gh pr view'
                      (run from --project when --repo is not given).
                      Use AFTER the PR exists (reviewer / auto-merge).
  --repo <owner/name> Repo for --pr mode. Default: gh's auto-detection.
  --project <root>    Project root (where .atelier.json lives). Default: cwd.
  --help, -h          Show this help and exit.

EXIT CODES:
  0  within limits
  1  oversize (BOTH limits exceeded after exemptions, or an exempt-only
     PR above prSize.maxExemptOnlyLines)
  2  error (unknown ref, failed git/gh call, truncated gh file list)

CONFIG (<project-root>/.atelier.json):
  {
    "prSize": {
      "maxLines": 200,
      "maxFiles": 10,
      "maxExemptOnlyLines": 400,
      "exempt": ["docs/**", ...]
    }
  }
Missing file or missing key falls back to built-in defaults. "exempt"
entries are ADDED to the built-in defaults (lockfiles, snapshots,
generated dirs, tests, migrations, root ROADMAP.md / IN_PROGRESS.md /
HISTORY.md); they never replace them.
"maxExemptOnlyLines" must be a non-negative integer.
EOF
}

# ---------- arg parse ----------
MODE=""        # branch | pr
BRANCH=""
BASE="main"
PR=""
REPO=""
PROJECT="$(pwd)"

while [ $# -gt 0 ]; do
  case "$1" in
    --branch)  [ -n "${2:-}" ] || die "--branch requires a value"; MODE="branch"; BRANCH="$2"; shift 2 ;;
    --branch=*) MODE="branch"; BRANCH="${1#--branch=}"; shift ;;
    --base)    [ -n "${2:-}" ] || die "--base requires a value"; BASE="$2"; shift 2 ;;
    --base=*)  BASE="${1#--base=}"; shift ;;
    --pr)      [ -n "${2:-}" ] || die "--pr requires a value"; MODE="pr"; PR="$2"; shift 2 ;;
    --pr=*)    MODE="pr"; PR="${1#--pr=}"; shift ;;
    --repo)    [ -n "${2:-}" ] || die "--repo requires a value"; REPO="$2"; shift 2 ;;
    --repo=*)  REPO="${1#--repo=}"; shift ;;
    --project) [ -n "${2:-}" ] || die "--project requires a value"; PROJECT="$2"; shift 2 ;;
    --project=*) PROJECT="${1#--project=}"; shift ;;
    --help|-h) usage; exit 0 ;;
    *) die "unknown arg: $1 (run --help for usage)" ;;
  esac
done

[ -n "$MODE" ] || die "must pass --branch or --pr (run --help for usage)"
[ -d "$PROJECT" ] || die "project root not a directory: $PROJECT"

# ---------- dependency check ----------
command -v jq >/dev/null 2>&1 || die "jq not found in PATH"
if [ "$MODE" = "pr" ]; then
  command -v gh >/dev/null 2>&1 || die "gh not found in PATH (required for --pr mode)"
fi
if [ "$MODE" = "branch" ]; then
  command -v git >/dev/null 2>&1 || die "git not found in PATH (required for --branch mode)"
fi

# ---------- config load ----------
CONFIG_FILE="$PROJECT/.atelier.json"
MAX_LINES="$DEFAULT_MAX_LINES"
MAX_FILES="$DEFAULT_MAX_FILES"
MAX_EXEMPT_ONLY_LINES="$DEFAULT_MAX_EXEMPT_ONLY_LINES"
EXEMPT=("${DEFAULT_EXEMPT[@]}")

if [ -f "$CONFIG_FILE" ]; then
  jq empty "$CONFIG_FILE" >/dev/null 2>&1 \
    || die "$CONFIG_FILE is not valid JSON"

  local_max_lines="$(jq -r '.prSize.maxLines // empty' "$CONFIG_FILE")"
  local_max_files="$(jq -r '.prSize.maxFiles // empty' "$CONFIG_FILE")"
  [ -n "$local_max_lines" ] && MAX_LINES="$local_max_lines"
  [ -n "$local_max_files" ] && MAX_FILES="$local_max_files"

  cap_type="$(jq -r '.prSize.maxExemptOnlyLines | type' "$CONFIG_FILE")" \
    || die "cannot read prSize.maxExemptOnlyLines from $CONFIG_FILE"
  if [ "$cap_type" != "null" ]; then
    local_cap="$(jq -r 'if (.prSize.maxExemptOnlyLines | type) == "number" then .prSize.maxExemptOnlyLines | tostring else "" end' "$CONFIG_FILE")"
    case "$local_cap" in
      ''|*[!0-9]*) die "prSize.maxExemptOnlyLines in $CONFIG_FILE must be a non-negative integer" ;;
    esac
    MAX_EXEMPT_ONLY_LINES="$local_cap"
  fi

  # Config exempt globs EXTEND the defaults. They are read line by line into
  # the array (never word-split via $(...)) so a glob such as `**/*.spec.*`
  # is not pathname-expanded against the cwd.
  raw_exempt="$(jq -r '(.prSize.exempt // [])[] | strings' "$CONFIG_FILE")" \
    || die "cannot read prSize.exempt from $CONFIG_FILE"
  while IFS= read -r g; do
    [ -n "$g" ] && EXEMPT+=("$g")
  done <<<"$raw_exempt"
fi

# ---------- glob matching ----------
# Returns 0 (true) when $1 matches any pattern in EXEMPT.
#
# We deliberately rely on bash's `case` pattern syntax (NOT filesystem
# globbing). Inside `case ... esac`, `*` matches any sequence of
# characters *including* `/` — so `**/foo.test.*` parses as `*/foo.test.*`
# in bash 3.2 (macOS default) and matches paths with at least one slash.
# This is portable to bash 3.2 without `shopt -s globstar`. Root-level
# files (no `/`) match the bare-name patterns (`pnpm-lock.yaml`), and the
# loop below also tries every `**/`-prefixed pattern without the prefix, so
# `**/*.test.*` and `**/generated/**` match at the root too.
path_is_exempt() {
  local path="$1" pat pat_no_prefix
  for pat in "${EXEMPT[@]+"${EXEMPT[@]}"}"; do
    # shellcheck disable=SC2254  # we intentionally use $pat as a glob pattern
    case "$path" in
      $pat) return 0 ;;
    esac
    # If pattern starts with `**/`, also try the unprefixed version so it
    # matches root-level paths too (bash 3.2 `case` requires at least one
    # separator for the `*/` part, so `**/tests/**` alone would miss the
    # root-level `tests/foo.ts`).
    if [ "${pat#\*\*/}" != "$pat" ]; then
      pat_no_prefix="${pat#\*\*/}"
      # shellcheck disable=SC2254
      case "$path" in
        $pat_no_prefix) return 0 ;;
      esac
    fi
  done
  return 1
}

# ---------- gather diff stats ----------
# Produce TSV text (<additions>\t<deletions>\t<path>) per changed file. Every
# failure exits 2: the diff is captured into a variable (never read through
# process substitution, which would swallow the exit status) so a failed git
# or gh call can never be mistaken for an empty, in-limits diff.
BASE_REF=""
BASE_NOTE=""
diff_tsv=""

if [ "$MODE" = "branch" ]; then
  git -C "$PROJECT" rev-parse --verify -q "${BRANCH}^{commit}" >/dev/null 2>&1 \
    || die "branch '$BRANCH' not found in $PROJECT; cannot evaluate PR size"
  case "$BASE" in
    origin/*) BASE_REF="$BASE" ;;
    *)
      if git -C "$PROJECT" rev-parse --verify -q "refs/remotes/origin/${BASE}^{commit}" >/dev/null 2>&1; then
        BASE_REF="origin/${BASE}"
      elif git -C "$PROJECT" rev-parse --verify -q "refs/heads/${BASE}^{commit}" >/dev/null 2>&1; then
        BASE_REF="$BASE"
        BASE_NOTE="Base: ${BASE} (local; origin/${BASE} not found)"
      else
        die "base '$BASE' not found as origin/${BASE} or local ${BASE} in $PROJECT; run: git -C $PROJECT fetch origin ${BASE}"
      fi
      ;;
  esac
  git -C "$PROJECT" rev-parse --verify -q "${BASE_REF}^{commit}" >/dev/null 2>&1 \
    || die "base ref '$BASE_REF' not found in $PROJECT; run: git -C $PROJECT fetch origin ${BASE#origin/}"
  # `git diff --numstat` produces: <add>\t<del>\t<path>. Binary files
  # show as `-\t-\t<path>` — counted as 0 lines, 1 file (see loop below).
  diff_tsv="$(git -C "$PROJECT" diff --numstat "${BASE_REF}...${BRANCH}")" \
    || die "git diff ${BASE_REF}...${BRANCH} failed in $PROJECT; run: git -C $PROJECT fetch origin ${BASE#origin/}"
else
  repo_flag=()
  [ -n "$REPO" ] && repo_flag=(--repo "$REPO")
  # bash 3.2 (macOS system bash) treats an empty array's [@] expansion as
  # "unbound" under set -u, aborting here when --repo is not passed. The
  # "${arr[@]+"${arr[@]}"}" idiom expands to nothing when the array is
  # empty/unset, and to the quoted elements otherwise — portable to 3.2+.
  # Run from the project so gh resolves the repo from it when --repo is absent.
  pr_json="$(cd "$PROJECT" && gh pr view "$PR" "${repo_flag[@]+"${repo_flag[@]}"}" --json files,changedFiles)" \
    || die "gh pr view $PR failed; check 'gh auth status' and that the PR/repo exist"
  jq -e '(.files|type=="array") and (.changedFiles|type=="number")' <<<"$pr_json" >/dev/null 2>&1 \
    || die "gh pr view $PR returned an unexpected payload (no files/changedFiles); check 'gh auth status'"
  pr_changed="$(jq -r '.changedFiles' <<<"$pr_json")"
  pr_listed="$(jq -r '.files|length' <<<"$pr_json")"
  [ "$pr_changed" -le "$pr_listed" ] \
    || die "PR #$PR has $pr_changed files but gh returned $pr_listed; size cannot be evaluated"
  diff_tsv="$(jq -r '.files[] | [.additions, .deletions, .path] | @tsv' <<<"$pr_json")" \
    || die "could not parse the file list of PR #$PR"
fi

# ---------- evaluate ----------
total_lines=0
total_files=0
exempt_lines=0
exempt_files=0
exempt_paths=()
counted_paths=()

while IFS=$'\t' read -r a d path; do
  [ -z "$path" ] && continue
  [ "$a" = "-" ] && a=0
  [ "$d" = "-" ] && d=0
  s=$((a + d))

  if path_is_exempt "$path"; then
    exempt_lines=$((exempt_lines + s))
    exempt_files=$((exempt_files + 1))
    exempt_paths+=("$path")
  else
    total_lines=$((total_lines + s))
    total_files=$((total_files + 1))
    counted_paths+=("$path")
  fi
done <<<"$diff_tsv"

# ---------- decide ----------
# AND-gate: BOTH limits exceeded → oversize. Either alone passes.
# Exempt-only PRs (nothing counted) are capped separately so exemptions
# cannot hide an arbitrarily large change.
verdict="OK"
exit_code=0
reason=""
if [ "$total_lines" -gt "$MAX_LINES" ] && [ "$total_files" -gt "$MAX_FILES" ]; then
  verdict="OVERSIZE"
  exit_code=1
  reason="counted lines $total_lines > $MAX_LINES AND counted files $total_files > $MAX_FILES."
elif [ "$total_files" -eq 0 ] && [ "$exempt_files" -gt 0 ] && [ "$exempt_lines" -gt "$MAX_EXEMPT_ONLY_LINES" ]; then
  verdict="OVERSIZE"
  exit_code=1
  reason="exempt-only PR: $exempt_lines exempt lines > $MAX_EXEMPT_ONLY_LINES"
fi

# ---------- suggest slicing boundaries (oversize only) ----------
# Group counted paths by their top-level directory and report the top
# groups by file count as natural slice candidates. `pr-author` stops on
# exit 1; the operator / orchestrator sees these as hints for next-pass
# task splitting. Implementation uses sort + uniq instead of associative
# arrays so it stays portable to bash 3.2 (macOS system bash).
suggest_slicing() {
  [ "${#counted_paths[@]}" -gt 0 ] || return 0
  printf '  Suggested slice boundaries by top-level dir (file count):\n'
  printf '%s\n' "${counted_paths[@]}" \
    | awk -F/ '{print (NF > 1 ? $1 : ".")}' \
    | sort | uniq -c | sort -rn | head -3 \
    | awk '{printf "    %s: %d file(s)\n", $2, $1}'
}

# ---------- report ----------
printf '== atelier-pr-size-check ==\n'
printf 'Mode:        %s\n' "$MODE"
[ "$MODE" = "branch" ] && printf 'Branch:      %s ... %s\n' "$BRANCH" "$BASE_REF"
[ -n "$BASE_NOTE" ] && printf '%s\n' "$BASE_NOTE"
[ "$MODE" = "pr" ]     && printf 'PR:          #%s%s\n' "$PR" "${REPO:+ ($REPO)}"
printf 'Project:     %s\n' "$PROJECT"
printf 'Config:      %s\n' "$([ -f "$CONFIG_FILE" ] && echo "$CONFIG_FILE" || echo "(defaults — no .atelier.json)")"
printf 'Limits:      lines=%d  files=%d  (AND-gate: both must exceed)  exempt-only cap=%d lines\n' "$MAX_LINES" "$MAX_FILES" "$MAX_EXEMPT_ONLY_LINES"
printf '\n'
printf 'Counted:     %d line(s) across %d file(s)\n' "$total_lines" "$total_files"
printf 'Exempt:      %d line(s) across %d file(s)\n' "$exempt_lines" "$exempt_files"
printf '\n'
printf 'Verdict:     %s\n' "$verdict"
if [ "$exit_code" = "1" ]; then
  printf '             %s\n' "$reason"
  suggest_slicing
fi

exit "$exit_code"
