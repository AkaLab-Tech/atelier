#!/usr/bin/env bash
#
# atelier-size-waiver — read-only resolution of an operator PR-size waiver (#542, 538a) and of
# an operator protected-paths approval (#545, guardrail 4), which share one trust model.
#
# Usage: atelier-size-waiver [--kind size|protected-paths] <owner/repo> <NN> [--project <root>]
#        atelier-size-waiver <owner/repo> <NN> --project <root>
#        atelier-size-waiver --question <owner/repo> <NN> --project <root> [--lang es|en]
#        atelier-size-waiver --package-json-version-only <owner/repo> <NN>
#
# Output: exactly one line on stdout.
#   waiver=valid kind=<kind> [skipped_agent=<N>] source=review|selector sha=<40-hex> by=<login> at=<iso> review=<url> reason=<text>
#   waiver=none                      no PR review carries a waiver phrase with a non-empty reason
#   waiver=stale sha=<40-hex>        newest waiver review covered an older head; sha = that commit
#   waiver=untrusted by=<login> (<why>)  newest waiver review is from an agent/PR author/bot,
#                                    or from someone without admin/maintain on the repo
#   waiver=ambiguous                 newest review carries phrases of more than one kind; it
#                                    grants nothing for any kind
# Every non-valid line ends with `source=review|selector` (which path produced the result).
# On the review path, `skipped_agent=<N>` (N >= 1) appears right before `source=review` when N
# agent-authored phrase-bearing reviews were set aside (see decision order step 2); absent when 0.
# Exit: 0 valid · 1 none/stale/untrusted/ambiguous · 2 error/usage (fail closed, never a pass).
#
# A waiver is a PR *review* (state COMMENTED or APPROVED; DISMISSED and CHANGES_REQUESTED do not
# count, nor do issue comments) whose body contains a waiver phrase, matched case-insensitively
# (kind "size": `waive size`, `size waiver`, `exención de tamaño`; kind "protected-paths":
# `approve protected paths`, `apruebo archivos protegidos`). The text after the phrase is the
# reason; an empty reason means the review is not a waiver at all. Kinds never cross-match.
#
# Decision order (deterministic):
#   1. Keep reviews with state COMMENTED/APPROVED, a phrase, and a non-empty reason.
#   2. Agent-authored reviews (atelier author/reviewer agent login, resolved live, or a bot:
#      [bot] suffix / app/ prefix) are set aside first, so an agent-written phrase, even one with
#      several kinds, cannot mask an older operator review. Of the rest take the NEWEST by
#      submittedAt; none -> waiver=none. Older ones are never consulted. When ONLY agent reviews
#      exist, the newest of them is kept and judged in step 3 (untrusted / ambiguous), as before.
#   3. Author is an agent (the one check from step 2), the PR author, or unknown -> untrusted.
#   4. commit.oid != current headRefOid -> stale.
#   5. Author lacks admin/maintain, read live from collaborators/<login>/permission
#      (HTTP 404 = not a collaborator) -> untrusted. Any other API failure -> exit 2.
#   6. Otherwise valid.
# A review carrying phrases of more than one kind is ambiguous: it counts as the newest review
# for each of those kinds and yields waiver=ambiguous (exit 1), never valid.
# No local file or config value can grant a waiver. gh reads only; no state is modified.
#
# Selector path (kind size, --project given; evaluated only when the review path is not valid):
# the record the capture hook wrote after the operator answered the size-waiver AskUserQuestion
# (hooks/lib/size-waiver-record.sh). It is valid only when ALL hold: the canonical record path
# for this repo/PR is the only file read (regular file, not a symlink, repo/PR fields match);
# its HMAC verifies with state/consent/size-waiver.key (the helper never creates the key); its
# sha equals the live headRefOid; and atelier-pr-size-check's own counted size is <= the
# recorded lines AND files. A size-check exit 2 makes this helper exit 2; a missing library
# fails the selector path closed with exit 2. It never reads decisions.jsonl, plan blocks or
# .task-log. --project is ignored for kind protected-paths (never reads selector records) and
# for --package-json-version-only. A size-check error is never waivable.
#
# --question <owner/repo> <NN> --project <root> [--lang es|en]: --lang picks the question language
# (default en; any other value exits 2). Prints the canonical AskUserQuestion JSON
# (marker with live head sha and counted size) and exits 0 when the PR is oversize; prints
# `question=none (within size budget)` and exits 1 when within budget; size-check error -> 2.
#
# --kind selects the phrase set; sets in kind_phrases() must never overlap. An unknown kind
# exits 2.
#
# --package-json-version-only (guardrail 4 exemption): prints `package-json=version-only` (exit 0)
# when the PR's root package.json differs from its merge-base copy ONLY in the top-level
# "version" value (jq 'del(.version)' equality), else `package-json=changed` (exit 1). Any
# fetch or parse failure exits 2 (fail closed: the caller keeps package.json forbidden).

set -u

if [ "${1:-}" = "--help" ] || [ "${1:-}" = "-h" ]; then
  sed -n '2,68p' "$0" | sed 's/^# \{0,1\}//'
  exit 0
fi

usage="usage: atelier-size-waiver [--kind size|protected-paths] <owner/repo> <NN> [--project <root>] | --question <owner/repo> <NN> --project <root> [--lang es|en]"
mode="waiver"
kind="size"
project=""
question=0
lang="en"
pos=()
if [ "${1:-}" = "--package-json-version-only" ]; then
  mode="pkgver"; shift
fi
while [ $# -gt 0 ]; do
  case "$1" in
    --kind) [ $# -ge 2 ] || { echo "$usage" >&2; exit 2; }; kind="$2"; shift 2 ;;
    --project) [ $# -ge 2 ] || { echo "$usage" >&2; exit 2; }; project="$2"; shift 2 ;;
    --lang) [ $# -ge 2 ] || { echo "$usage" >&2; exit 2; }; lang="$2"; shift 2 ;;
    --question) question=1; shift ;;
    *) pos+=("$1"); shift ;;
  esac
done
[ "${#pos[@]}" -eq 2 ] || { echo "$usage" >&2; exit 2; }
if [ "$question" = 1 ] && { [ -z "$project" ] || [ "$kind" != size ] || [ "$mode" != waiver ]; }; then
  echo "$usage" >&2; exit 2
fi
case "$lang" in es|en) ;; *) echo "$usage" >&2; exit 2 ;; esac
repo="${pos[0]}"; pr="${pos[1]}"
case "$pr" in ''|*[!0-9]*) echo "atelier-size-waiver: <NN> must be a PR number" >&2; exit 2 ;; esac
case "$repo" in */*) ;; *) echo "atelier-size-waiver: <owner/repo> expected" >&2; exit 2 ;; esac

ATELIER_CONFIG_DIR="${ATELIER_CONFIG_DIR:-$HOME/.claude-work}"

fail() { echo "atelier-size-waiver: $1" >&2; exit 2; }

# Regex alternation (Oniguruma, matched case-insensitively) per kind.
kind_phrases() {
  case "$1" in
    size) printf '%s' 'waive size|size waiver|exención de tamaño' ;;
    protected-paths) printf '%s' 'approve protected paths|apruebo archivos protegidos' ;;
    *) return 1 ;;
  esac
}

# Phrases of every kind except $1, joined; used to detect ambiguous reviews.
other_phrases() {
  local k out="" p
  for k in size protected-paths; do
    [ "$k" = "$1" ] && continue
    p="$(kind_phrases "$k")"
    out="${out:+$out|}$p"
  done
  printf '%s' "$out"
}

agent_login() {
  GH_CONFIG_DIR="$ATELIER_CONFIG_DIR/gh/$1" gh api user --jq .login
}

# Plugin root, as scripts/atelier-align resolves it: $ATELIER_PLUGIN_ROOT, then dirname(realpath(self))/..
plugin_root_lib() {
  local self="${BASH_SOURCE[0]}" d cand
  while [ -L "$self" ]; do d="$(cd -P "$(dirname "$self")" && pwd)"; self="$(readlink "$self")"; case "$self" in /*) ;; *) self="$d/$self";; esac; done
  d="$(cd -P "$(dirname "$self")" && pwd)"
  for cand in "${ATELIER_PLUGIN_ROOT:-}" "$(dirname "$d")"; do
    [ -n "$cand" ] || continue
    [ -f "$cand/hooks/lib/size-waiver-record.sh" ] && { printf '%s' "$cand/hooks/lib/size-waiver-record.sh"; return 0; }
  done
  return 1
}

load_lib() {
  local lib
  lib="$(plugin_root_lib)" || fail "size-waiver record library not found (selector path fails closed)"
  # shellcheck source=/dev/null
  source "$lib" || fail "cannot load size-waiver record library"
}

# Runs atelier-pr-size-check; sets sc_rc, sc_lines, sc_files. Exit 2 / unparsable -> helper exit 2.
run_size_check() {
  local out
  out="$(atelier-pr-size-check --pr "$pr" --repo "$repo" --project "$project" 2>/dev/null)"; sc_rc=$?
  [ "$sc_rc" -le 1 ] || fail "size check failed (exit $sc_rc)"
  sc_lines="$(printf '%s\n' "$out" | sed -n 's/^Counted: *\([0-9][0-9]*\) line(s) across \([0-9][0-9]*\) file(s).*/\1/p' | head -n1)"
  sc_files="$(printf '%s\n' "$out" | sed -n 's/^Counted: *\([0-9][0-9]*\) line(s) across \([0-9][0-9]*\) file(s).*/\2/p' | head -n1)"
  [ -n "$sc_lines" ] && [ -n "$sc_files" ] || fail "cannot parse size check output"
}

command -v jq >/dev/null 2>&1 || fail "jq not found"

if [ "$mode" = "pkgver" ]; then
  pr_refs="$(gh api "repos/$repo/pulls/$pr" --jq '[.base.sha, .head.sha] | @tsv' 2>/dev/null)" \
    || fail "cannot read PR $repo#$pr"
  base_ref="${pr_refs%%$'\t'*}"; head_ref="${pr_refs#*$'\t'}"
  [ -n "$base_ref" ] && [ -n "$head_ref" ] || fail "PR has no base/head sha"
  merge_base="$(gh api "repos/$repo/compare/$base_ref...$head_ref" --jq .merge_base_commit.sha 2>/dev/null)" \
    || fail "cannot resolve merge base"
  [ -n "$merge_base" ] || fail "empty merge base"
  base_pkg="$(gh api "repos/$repo/contents/package.json?ref=$merge_base" -H 'Accept: application/vnd.github.raw' 2>/dev/null)" \
    || fail "cannot read package.json at base"
  head_pkg="$(gh api "repos/$repo/contents/package.json?ref=$head_ref" -H 'Accept: application/vnd.github.raw' 2>/dev/null)" \
    || fail "cannot read package.json at head"
  base_norm="$(printf '%s' "$base_pkg" | jq -S -c 'del(.version)' 2>/dev/null)" || fail "cannot parse base package.json"
  head_norm="$(printf '%s' "$head_pkg" | jq -S -c 'del(.version)' 2>/dev/null)" || fail "cannot parse head package.json"
  [ -n "$base_norm" ] && [ -n "$head_norm" ] || fail "empty package.json parse"
  if [ "$base_norm" = "$head_norm" ]; then
    echo "package-json=version-only"; exit 0
  fi
  echo "package-json=changed"; exit 1
fi

if [ "$question" = 1 ]; then
  load_lib
  q_json="$(gh pr view "$pr" --repo "$repo" --json headRefOid 2>/dev/null)" || fail "cannot read PR $repo#$pr"
  q_sha="$(printf '%s' "$q_json" | jq -r '.headRefOid // ""')"
  [ -n "$q_sha" ] || fail "PR has no head sha"
  run_size_check
  if [ "$sc_rc" = 0 ]; then
    echo "question=none (within size budget)"; exit 1
  fi
  swr_question "$repo" "$pr" "$q_sha" "$sc_lines" "$sc_files" "$lang" || fail "cannot build question"
  exit 0
fi

phrases="$(kind_phrases "$kind")" || fail "unknown kind: $kind"
others="$(other_phrases "$kind")"
author_agent="$(agent_login author 2>/dev/null)" || fail "cannot resolve author agent login"
reviewer_agent="$(agent_login reviewer 2>/dev/null)" || fail "cannot resolve reviewer agent login"
[ -n "$author_agent" ] && [ -n "$reviewer_agent" ] || fail "empty agent login"
pr_json="$(gh pr view "$pr" --repo "$repo" --json author,headRefOid,reviews,url 2>/dev/null)" \
  || fail "cannot read PR $repo#$pr"

# Review path; run in a subshell by the driver below so its exits become a captured result.
review_path() {
# Chosen phrase-bearing review plus the agent-skip count, as one JSON object; reason is
# whitespace-collapsed. Agent identity (bot account / author agent / reviewer agent) is decided here,
# once, before the newest review is chosen: agent-authored reviews are set aside while any non-agent
# phrase-bearing review exists, so they cannot mask an older operator waiver. With no non-agent
# review the newest agent one is kept and later judged untrusted, exactly as before.
sel="$(printf '%s' "$pr_json" | jq -c --arg re "($phrases)" --arg other "($others)" \
    --arg aa "$author_agent" --arg ra "$reviewer_agent" '
  ($aa | ascii_downcase) as $aal | ($ra | ascii_downcase) as $ral
  | [ .reviews[]?
    | select(.state == "COMMENTED" or .state == "APPROVED")
    | . as $r
    | ((.body // "") | capture("(?:" + $re + ")[\\s:—–-]*(?<reason>.*)"; "is")?) as $m
    | select($m != null)
    | ((.body // "") | test($other; "i")) as $amb
    | ($m.reason | gsub("\\s+"; " ") | sub("^ "; "") | sub(" $"; "")) as $reason
    | select($amb or $reason != "")
    | (($r.author.login // "") | ascii_downcase) as $l
    | { amb: $amb, by: ($r.author.login // ""), at: ($r.submittedAt // ""), sha: ($r.commit.oid // ""),
        url: ($r.url // ""), reason: $reason,
        agent: (if ($l | endswith("[bot]")) or ($l | startswith("app/")) then "bot account"
                elif $l == $aal then "atelier author agent"
                elif $l == $ral then "atelier reviewer agent"
                else "" end) }
  ] as $all
  | ($all | map(select(.agent == ""))) as $human
  | if ($human | length) > 0
    then { cand: ($human | sort_by(.at) | last), skipped: (($all | length) - ($human | length)) }
    else { cand: ($all | sort_by(.at) | last), skipped: 0 } end' 2>/dev/null)" || fail "cannot parse PR JSON"
[ -n "$sel" ] || fail "empty parse result"
cand="$(printf '%s' "$sel" | jq -c '.cand')" || fail "cannot parse PR JSON"
skipped="$(printf '%s' "$sel" | jq -r '.skipped')" || fail "cannot parse PR JSON"
sk=""
[ "$skipped" -gt 0 ] && sk=" skipped_agent=$skipped"
[ -n "$cand" ] || fail "empty parse result"

if [ "$cand" = "null" ]; then
  echo "waiver=none source=review"
  exit 1
fi

f() { printf '%s' "$cand" | jq -r ".$1"; }
if [ "$(f amb)" = "true" ]; then
  echo "waiver=ambiguous$sk source=review"
  exit 1
fi
by="$(f by)"; at="$(f at)"; sha="$(f sha)"; url="$(f url)"; reason="$(f reason)"
head_sha="$(printf '%s' "$pr_json" | jq -r '.headRefOid // ""')"
pr_author="$(printf '%s' "$pr_json" | jq -r '.author.login // ""')"
pr_url="$(printf '%s' "$pr_json" | jq -r '.url // ""')"
[ -n "$head_sha" ] || fail "PR has no head sha"
[ -n "$url" ] || url="$pr_url"

lc() { printf '%s' "$1" | tr '[:upper:]' '[:lower:]'; }

untrusted() { echo "waiver=untrusted by=$by ($1)$sk source=review"; exit 1; }

[ -n "$by" ] || untrusted "unknown author"
agent="$(f agent)"
[ -z "$agent" ] || untrusted "$agent"
[ "$(lc "$by")" != "$(lc "$pr_author")" ] || untrusted "PR author"

if [ "$sha" != "$head_sha" ]; then
  echo "waiver=stale sha=$sha$sk source=review"
  exit 1
fi

perm_err="$(mktemp)" || fail "mktemp failed"
trap 'rm -f "$perm_err"' EXIT
if perm_json="$(gh api "repos/$repo/collaborators/$by/permission" 2>"$perm_err")"; then
  role="$(printf '%s' "$perm_json" | jq -r '[.role_name // "", .permission // ""] | @tsv' 2>/dev/null)" \
    || fail "cannot parse permission for $by"
  role_name="${role%%$'\t'*}"; perm="${role#*$'\t'}"
  case "$role_name" in admin|maintain) ;; *)
    [ "$perm" = "admin" ] || untrusted "lacks admin/maintain permission" ;;
  esac
elif grep -q 'HTTP 404' "$perm_err"; then
  untrusted "not a collaborator"
else
  fail "cannot read permission for $by"
fi

printf 'waiver=valid kind=%s%s source=review sha=%s by=%s at=%s review=%s reason=%s\n' "$kind" "$sk" "$sha" "$by" "$at" "$url" "$reason"
exit 0
}

rv="$(review_path)"; rv_rc=$?
[ "$rv_rc" -le 1 ] || exit 2
if [ "$rv_rc" = 0 ] || [ "$kind" != size ] || [ -z "$project" ]; then
  printf '%s\n' "$rv"; exit "$rv_rc"
fi

# ---- Selector path (kind size, --project): the review path was not valid ----
load_lib
rec="$(swr_record_path "$repo" "$pr")"
if [ ! -e "$rec" ] && [ ! -L "$rec" ]; then
  printf '%s\n' "$rv"; exit 1
fi
sel_untrusted() { echo "waiver=untrusted by=selector ($1) source=selector"; exit 1; }
{ [ -f "$rec" ] && [ ! -L "$rec" ]; } || sel_untrusted "record is not a regular file"
rec_json="$(jq -c . "$rec" 2>/dev/null)" && [ -n "$rec_json" ] || sel_untrusted "malformed record"
rf() { printf '%s' "$rec_json" | jq -r ".$1 // empty"; }
[ "$(rf repo)" = "$repo" ] && [ "$(rf pr)" = "$pr" ] || sel_untrusted "record repo/PR mismatch"
[ -s "$(_consent_root)/size-waiver.key" ] || sel_untrusted "signing key missing"
[ -n "$(rf hmac)" ] || sel_untrusted "record has no MAC"
swr_verify "$rec" || sel_untrusted "MAC does not verify"
rec_sha="$(rf head_sha)"; rec_lines="$(rf lines)"; rec_files="$(rf files)"
case "$rec_lines$rec_files" in ''|*[!0-9]*) sel_untrusted "record size fields invalid" ;; esac
[ -n "$rec_lines" ] && [ -n "$rec_files" ] || sel_untrusted "record size fields invalid"
live_sha="$(printf '%s' "$pr_json" | jq -r '.headRefOid // ""')"
if [ "$rec_sha" != "$live_sha" ]; then
  echo "waiver=stale sha=$rec_sha source=selector"; exit 1
fi
run_size_check
if [ "$sc_lines" -gt "$rec_lines" ] || [ "$sc_files" -gt "$rec_files" ]; then
  echo "waiver=stale sha=$rec_sha source=selector (size grew: counted ${sc_lines}L/${sc_files}F > recorded ${rec_lines}L/${rec_files}F)"
  exit 1
fi
rec_by="$(rf session_id)"; rec_by="${rec_by:-operator}"
printf 'waiver=valid kind=size source=selector sha=%s by=%s at=%s review=selector reason=%s\n' \
  "$rec_sha" "$rec_by" "$(rf captured_at)" "$(rf answer)"
exit 0
