#!/usr/bin/env bash
#
# atelier-branch-protection — single source of truth for branch-protection
# classification and application (#45). Extracted from the two hand-copied
# variants that used to live in atelier-setup-project and atelier-doctor:
# the setup-project copy never disambiguated a 404 (mapped it straight to
# "unprotected"), and both copies always PUT as the author (bot) identity,
# which lacks repo-admin on every AkaLab-Tech member repo, so the PUT always
# 404s. This binary is the one place that logic lives now; both callers
# delegate to it instead of hand-copying it a third time.
#
# Usage:
#   atelier-branch-protection --status [--repo <owner/name>] [--branch <b>] [--json] [--quiet]
#   atelier-branch-protection --apply  [--repo <owner/name>] [--branch <b>] [--json] [--quiet]
#   atelier-branch-protection --manual [--repo <owner/name>] [--branch <b>]
#   atelier-branch-protection --help
#
# --repo / --branch default to `gh repo view` on the current directory's repo.
#
# --status classifies the branch's current protection and, when the class
# needs remediation (unprotected / protected-insufficient / no-admin), also
# probes for an admin-capable identity (see resolve_admin_gh_dir below) and
# reports it — this lets a caller (atelier-doctor) decide whether a fix is
# runnable without performing one.
#
# --apply classifies first under a (possibly unprivileged) probe identity,
# then, if remediation looks needed, resolves an admin identity and re-reads
# the rule UNDER THAT IDENTITY before touching anything — the probe identity
# may have 403'd or 404'd on a rule that is actually already sufficient, and
# only the admin identity can answer that question. Never PUTs a rule it can
# already see is sufficient; when it does PUT, it merges into the existing
# rule rather than overwriting it, and refuses (rather than guesses) when
# the existing rule uses a field this helper does not model. If the admin
# identity's re-read itself fails for any reason other than a confirmed-
# unprotected 404, --apply aborts without ever PUTting — a failed read is
# never treated as "no rule exists".
#
# --manual prints the copy-pasteable manual remediation block without ever
# probing an admin identity or reading the protection endpoint — the only
# call shape that is guaranteed non-mutating regardless of which identities
# happen to resolve at call time. Use this (never --apply) from a read-only
# caller, e.g. atelier-doctor without --fix, that only wants the instruction
# text.
#
# Exit codes:
#   0  --status: classification succeeded (any class).
#      --apply:  already sufficient, already protected, or applied.
#      --manual: block printed.
#   2  prerequisite missing (no gh/jq/git, not a git repo, no GitHub remote,
#      or an unexpected classify error) — advisory, never treat as fatal.
#      --apply also uses this code when an admin identity was found but its
#      re-read of the existing rule failed for a reason other than a
#      confirmed-unprotected 404 (transient error, secondary rate limit,
#      etc.) — no PUT is attempted in that case; the underlying gh error is
#      printed to stderr.
#   3  --apply only: no admin identity resolved, OR an admin identity was
#      found but the existing rule sets a field this helper does not model
#      (dismissal_restrictions / bypass_pull_request_allowances / a non-
#      empty top-level restrictions) and it refuses to guess. The copy-
#      pasteable manual `gh api -X PUT ...` block is printed on stdout
#      regardless of --json.
#   4  --apply only: an admin identity was found but the PUT itself failed.

set -uo pipefail

SCRIPT_NAME="$(basename "${BASH_SOURCE[0]}")"
die() { printf '!!  ERROR: %s\n' "$*" >&2; exit 2; }

usage() {
  cat <<EOF
${SCRIPT_NAME} — classify and apply branch protection on a repo's default branch.

USAGE:
  ${SCRIPT_NAME} --status [--repo <owner/name>] [--branch <b>] [--json] [--quiet]
  ${SCRIPT_NAME} --apply  [--repo <owner/name>] [--branch <b>] [--json] [--quiet]
  ${SCRIPT_NAME} --manual [--repo <owner/name>] [--branch <b>]
  ${SCRIPT_NAME} --help

OPTIONS:
  --status         Report the current classification (never mutates).
  --apply          Apply a minimal rule (>=1 required approving review) if
                    the branch needs it. Idempotent; never lowers an
                    existing rule (merges rather than overwrites); re-reads
                    the rule under the resolved admin identity before
                    deciding, so it never downgrades a rule the admin
                    identity can see is already sufficient.
  --manual         Print the manual remediation block only. Never probes an
                    admin identity or reads the protection endpoint —
                    guaranteed non-mutating regardless of which identities
                    resolve at call time. For read-only callers that only
                    want the instruction text (use instead of --apply).
  --repo <o/name>  Repo to target. Default: \`gh repo view\` on the cwd repo.
  --branch <b>     Branch to target. Default: the repo's default branch.
  --json           Emit machine-readable JSON on stdout instead of text.
                    (--manual always prints plain text; there is nothing to
                    classify.)
  --quiet          Suppress the human-readable success line (errors and the
                    manual instruction block, when applicable, still print).
  --help, -h       Show this help and exit.

ADMIN IDENTITY RESOLUTION (--apply, in order):
  1. \$ATELIER_ADMIN_GH_CONFIG_DIR      (explicit override / test seam)
  2. \$ATELIER_CONFIG_DIR/gh/admin      (dedicated atelier admin identity)
  3. \$ATELIER_CONFIG_DIR/gh/author     (free win on bot-owned repos)
  4. \${XDG_CONFIG_HOME:-\$HOME/.config}/gh  (the operator's personal gh config,
                                          tried last, used only to read
                                          viewerPermission and to PUT)

EXIT CODES:
  0  status classified, apply succeeded / already sufficient, or manual block printed
  2  prerequisite missing (advisory); or --apply: admin identity found but its
     re-read of the existing rule failed for a reason other than a confirmed-
     unprotected 404 — no PUT attempted, underlying gh error on stderr
  3  --apply: no admin identity resolved, or the existing rule uses a field
     this helper does not model (manual block printed on stdout either way)
  4  --apply: admin identity found but the PUT failed
EOF
}

MODE=""
REPO=""
BRANCH=""
JSON=false
QUIET=false

while [ $# -gt 0 ]; do
  case "$1" in
    --status) MODE="status"; shift ;;
    --apply)  MODE="apply"; shift ;;
    --manual) MODE="manual"; shift ;;
    --repo)   [ -n "${2:-}" ] || die "--repo requires a value"; REPO="$2"; shift 2 ;;
    --repo=*) REPO="${1#--repo=}"; shift ;;
    --branch)   [ -n "${2:-}" ] || die "--branch requires a value"; BRANCH="$2"; shift 2 ;;
    --branch=*) BRANCH="${1#--branch=}"; shift ;;
    --json)   JSON=true; shift ;;
    --quiet)  QUIET=true; shift ;;
    --help|-h) usage; exit 0 ;;
    *) die "unknown arg: $1 (run --help for usage)" ;;
  esac
done

[ -n "$MODE" ] || die "must pass --status, --apply, or --manual (run --help for usage)"
command -v gh >/dev/null 2>&1 || die "gh not found on PATH"
command -v jq >/dev/null 2>&1 || die "jq not found on PATH"

MIN_PAYLOAD='{"required_status_checks":null,"enforce_admins":false,"required_pull_request_reviews":{"required_approving_review_count":1},"restrictions":null}'

# ---------- classify_branch_protection <gh_dir> <owner_repo> <branch> ----------
# Post-#284 classifier (verbatim from the doctor's inline copy — kept
# extractable by name for hooks/tests/*.test.sh, same as the two copies it
# replaces). Prints one of:
#   protected-sufficient   — required_approving_review_count >= 1
#   protected-noadmin      — 404 on the protection endpoint, but the no-admin-
#                             safe branch endpoint confirms .protected == true
#                             (the token can't read the detail, but the rule
#                             exists — never propose a PUT the identity can't run)
#   protected-insufficient — protection exists but no required approving reviews
#   unprotected             — genuinely no rule (branch endpoint .protected == false)
#   no-admin                — token lacks repo-admin (GitHub 403)
#   skip:<msg>              — unexpected error; treat as advisory skip
classify_branch_protection() {
  local auth_dir="$1" owner_repo="$2" branch="$3"
  local out rc err_file err_msg
  err_file="$(mktemp)"
  out="$(env GH_CONFIG_DIR="$auth_dir" \
    gh api "repos/$owner_repo/branches/$branch/protection" 2>"$err_file")" && rc=0 || rc=$?
  err_msg="$(<"$err_file")"
  rm -f "$err_file"
  if [ "$rc" -eq 0 ]; then
    local count
    count="$(printf '%s' "$out" | \
      jq -r '.required_pull_request_reviews.required_approving_review_count // 0' 2>/dev/null || printf '0')"
    count="${count:-0}"
    if [ "$count" -ge 1 ]; then
      printf 'protected-sufficient'
    else
      printf 'protected-insufficient'
    fi
    return
  fi
  case "$err_msg" in
    *"Must have admin"*|*"Resource not accessible"*|*"HTTP 403"*)
      printf 'no-admin'
      ;;
    *"Branch not protected"*|*"HTTP 404"*|*"Not Found"*)
      # A 404 here is AMBIGUOUS: the branch may be genuinely unprotected, OR
      # it may be protected while this (non-admin) token simply lacks access
      # to read the protection detail — GitHub returns 404, not 403, in that
      # second case. Disambiguate via the no-admin-safe branch endpoint,
      # whose `.protected` flag every collaborator can read.
      local protected_flag
      protected_flag="$(env GH_CONFIG_DIR="$auth_dir" \
        gh api "repos/$owner_repo/branches/$branch" --jq '.protected' 2>/dev/null)"
      if [ "$protected_flag" = "true" ]; then
        printf 'protected-noadmin'
      else
        printf 'unprotected'
      fi
      ;;
    *) printf 'skip:%s' "$(printf '%s' "$err_msg" | head -1 2>/dev/null)" ;;
  esac
}

# ---------- admin_candidate_dirs ----------
# Emits the fixed candidate list, one per line, in resolution order. Shared
# by resolve_admin_gh_dir() and the manual-instruction block so both agree
# on which identities were tried.
admin_candidate_dirs() {
  [ -n "${ATELIER_ADMIN_GH_CONFIG_DIR:-}" ] && printf '%s\n' "$ATELIER_ADMIN_GH_CONFIG_DIR"
  [ -n "${ATELIER_CONFIG_DIR:-}" ] && printf '%s\n' "$ATELIER_CONFIG_DIR/gh/admin"
  [ -n "${ATELIER_CONFIG_DIR:-}" ] && printf '%s\n' "$ATELIER_CONFIG_DIR/gh/author"
  printf '%s\n' "${XDG_CONFIG_HOME:-$HOME/.config}/gh"
}

# ---------- resolve_admin_gh_dir <owner_repo> ----------
# Walks admin_candidate_dirs() and returns (on stdout, rc 0) the first
# GH_CONFIG_DIR that both exists and reports viewerPermission == ADMIN for
# owner_repo. Returns rc 1 with no output when none qualifies. Candidate 4
# (the operator's personal gh config) is spelled literally here — NOT
# reached by unsetting GH_CONFIG_DIR — because atelier sessions export
# GH_CONFIG_DIR=$ATELIER_CONFIG_DIR/gh/author, so "unset" would not
# reliably land on the personal config.
resolve_admin_gh_dir() {
  local owner_repo="$1" candidate perm
  while IFS= read -r candidate; do
    [ -n "$candidate" ] && [ -d "$candidate" ] || continue
    perm="$(env GH_CONFIG_DIR="$candidate" \
      gh repo view "$owner_repo" --json viewerPermission --jq .viewerPermission 2>/dev/null || true)"
    if [ "$perm" = "ADMIN" ]; then
      printf '%s' "$candidate"
      return 0
    fi
  done < <(admin_candidate_dirs)
  return 1
}

# ---------- apply_protection <gh_dir> <owner_repo> <branch> ----------
# Merge-not-overwrite payload builder + PUT + re-verify classify. Assumes
# the caller already confirmed gh_dir has admin on owner_repo — but that
# confirmation is only about permission, not about the rule's current
# strength, so the FIRST thing this function does is re-read the rule under
# gh_dir and re-decide from that read (#45 review, critical finding): the
# earlier classification that got us here may have come from a less-
# privileged probe identity that 403'd or 404'd on a rule that is actually
# already sufficient. Never PUT a rule this identity can see is sufficient.
#
# On stdout: for "already-sufficient", one line ("already-sufficient\n
# protected-sufficient"). For "applied", three lines: "applied\n<class>\n
# <existing_enforce_admins>", the third line being the existing rule's
# enforce_admins.enabled BEFORE this call forced it back to false (used by
# the caller to note the relaxation in the success line — see #45 review,
# critical finding sub-point (a)). Returns 0 for either.
#
# Returns 1 if a PUT was attempted and failed.
#
# Returns 2 (no stdout) if the existing rule sets a field this helper does
# not model (dismissal_restrictions / bypass_pull_request_allowances / a
# non-empty top-level restrictions) and refuses to guess at it — the caller
# is expected to print the manual block in that case.
#
# Returns 3 (no stdout; the raw gh stderr is written to this function's own
# stderr) if the re-read under gh_dir failed for a reason OTHER than a
# confirmed-unprotected 404 (transient 5xx, secondary rate limit, network
# error, or a 404 whose branch-detail companion read itself failed) — never
# treat a failed read as "no rule exists" (#45 review, critical finding).
# The caller is expected to abort without any PUT in this case.
apply_protection() {
  local gh_dir="$1" owner_repo="$2" branch="$3"

  local existing existing_rc=0 err_file err_msg
  err_file="$(mktemp)"
  existing="$(env GH_CONFIG_DIR="$gh_dir" \
    gh api "repos/$owner_repo/branches/$branch/protection" 2>"$err_file")" || existing_rc=$?
  err_msg="$(<"$err_file")"
  rm -f "$err_file"

  local existing_count=0 existing_enforce_admins=false
  if [ "$existing_rc" -eq 0 ] && [ -n "$existing" ]; then
    existing_count="$(printf '%s' "$existing" | \
      jq -r '.required_pull_request_reviews.required_approving_review_count // 0' 2>/dev/null || printf '0')"
    existing_count="${existing_count:-0}"
    existing_enforce_admins="$(printf '%s' "$existing" | \
      jq -r '.enforce_admins.enabled // false' 2>/dev/null || printf 'false')"

    if [ "$existing_count" -ge 1 ]; then
      printf 'already-sufficient\nprotected-sufficient'
      return 0
    fi

    # dismissal_restrictions / bypass_pull_request_allowances / top-level
    # restrictions all hold user and team OBJECTS on GET but need login/slug
    # ID LISTS on PUT — reformatting them blind risks silently dropping who
    # they cover. Since PUT is a full replace, refuse rather than guess; the
    # manual block lets the operator carry them over by hand.
    local has_unmodeled_restrictions
    has_unmodeled_restrictions="$(printf '%s' "$existing" | jq -r '
      ((.required_pull_request_reviews.dismissal_restrictions // {}) as $d
       | (($d.users // []) | length) + (($d.teams // []) | length) > 0)
      or
      ((.required_pull_request_reviews.bypass_pull_request_allowances // {}) as $b
       | (($b.users // []) | length) + (($b.teams // []) | length) + (($b.apps // []) | length) > 0)
      or
      ((.restrictions // {}) as $r
       | (($r.users // []) | length) + (($r.teams // []) | length) + (($r.apps // []) | length) > 0)
    ' 2>/dev/null || printf 'false')"
    [ "$has_unmodeled_restrictions" = "true" ] && return 2
  elif [ "$existing_rc" -ne 0 ]; then
    # A non-zero read is either "genuinely no rule" (404, confirmed by the
    # no-admin-safe branch-detail endpoint's .protected == false — the same
    # disambiguation classify_branch_protection() performs) or some other
    # failure (transient 5xx, secondary rate limit, network error). Only the
    # first case is safe to start a MIN_PAYLOAD full-replace from. This
    # identity was already confirmed admin-capable by the caller, so any
    # other read failure here can never be read as "the rule doesn't exist"
    # — guessing wrong risks a full-replace PUT that wipes a rule this call
    # simply failed to read (#45 review, critical finding).
    local confirmed_unprotected=false protected_flag
    case "$err_msg" in
      *"Branch not protected"*|*"HTTP 404"*|*"Not Found"*)
        protected_flag="$(env GH_CONFIG_DIR="$gh_dir" \
          gh api "repos/$owner_repo/branches/$branch" --jq '.protected' 2>/dev/null)"
        [ "$protected_flag" = "false" ] && confirmed_unprotected=true
        ;;
    esac
    if ! $confirmed_unprotected; then
      printf '%s\n' "$err_msg" >&2
      return 3
    fi
  fi

  local review_count=1
  [ "$existing_count" -ge 1 ] && review_count="$existing_count"

  # Build payload: for an existing-but-insufficient rule, merge rather than
  # overwrite so stronger settings (status checks, code-owner reviews, and
  # the boolean protection flags PUT resets by default) are preserved.
  # enforce_admins=false lets the AtelierAuthor bot squash-merge its own
  # approved PRs — set this to true and auto-merge breaks in a new way,
  # because the bot itself would then be blocked by the rule it needs to
  # pass through. restrictions=null imposes no push restrictions.
  local payload=""
  if [ "$existing_rc" -eq 0 ] && [ -n "$existing" ]; then
    payload="$(printf '%s' "$existing" | jq --argjson count "$review_count" '{
      required_status_checks: (
        if .required_status_checks == null then null
        else {
          strict: (.required_status_checks.strict // false),
          contexts: (.required_status_checks.contexts // [])
        } end
      ),
      enforce_admins: false,
      required_pull_request_reviews: {
        dismiss_stale_reviews: (.required_pull_request_reviews.dismiss_stale_reviews // false),
        require_code_owner_reviews: (.required_pull_request_reviews.require_code_owner_reviews // false),
        require_last_push_approval: (.required_pull_request_reviews.require_last_push_approval // false),
        required_approving_review_count: $count
      },
      restrictions: null,
      required_linear_history: (.required_linear_history.enabled // false),
      required_conversation_resolution: (.required_conversation_resolution.enabled // false),
      allow_force_pushes: (.allow_force_pushes.enabled // false),
      allow_deletions: (.allow_deletions.enabled // false),
      block_creations: (.block_creations.enabled // false),
      lock_branch: (.lock_branch.enabled // false)
    }' 2>/dev/null || printf '')"
  fi
  [ -n "$payload" ] || payload="$MIN_PAYLOAD"

  local tmp_payload
  tmp_payload="$(mktemp)"
  printf '%s\n' "$payload" > "$tmp_payload"
  if env GH_CONFIG_DIR="$gh_dir" gh api -X PUT \
      "repos/$owner_repo/branches/$branch/protection" \
      --input "$tmp_payload" >/dev/null 2>&1; then
    rm -f "$tmp_payload"
    printf 'applied\n%s\n%s' "$(classify_branch_protection "$gh_dir" "$owner_repo" "$branch")" \
      "$existing_enforce_admins"
    return 0
  fi
  rm -f "$tmp_payload"
  return 1
}

# ---------- default_gh_dir ----------
# Identity used for the (never-mutating) initial classify probe: prefer the
# atelier author identity when configured, else gh's own default resolution
# order, spelled literally so it is always a concrete path.
default_gh_dir() {
  if [ -n "${ATELIER_CONFIG_DIR:-}" ] && [ -d "$ATELIER_CONFIG_DIR/gh/author" ]; then
    printf '%s' "$ATELIER_CONFIG_DIR/gh/author"
  else
    printf '%s' "${GH_CONFIG_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/gh}"
  fi
}

print_manual_block() {
  local owner_repo="$1" branch="$2"
  local tried
  tried="$(admin_candidate_dirs | paste -sd, - 2>/dev/null || admin_candidate_dirs | tr '\n' ',' | sed 's/,$//')"
  printf 'No admin identity available to apply branch protection on %s/%s.\n' "$owner_repo" "$branch"
  printf 'Tried: %s\n' "$tried"
  printf 'WARNING: the branch protection PUT endpoint is a full replace. If %s/%s\n' "$owner_repo" "$branch"
  printf 'already has a protection rule, pasting the command below as-is will\n'
  printf 'silently overwrite it down to this minimal rule. Read the existing rule\n'
  printf 'first (gh api "repos/%s/branches/%s/protection") and merge by hand if one exists.\n' "$owner_repo" "$branch"
  printf 'Apply manually with a repo-admin token:\n'
  printf "  printf '%%s\\\\n' '%s' | \\\\\n" "$MIN_PAYLOAD"
  printf '    gh api -X PUT "repos/%s/branches/%s/protection" --input -\n' "$owner_repo" "$branch"
}

print_unmergeable_block() {
  local owner_repo="$1" branch="$2"
  printf 'Existing branch protection on %s/%s sets dismissal_restrictions,\n' "$owner_repo" "$branch"
  printf 'bypass_pull_request_allowances, or a non-empty restrictions — this\n'
  printf 'helper does not model those fields and refuses to PUT a payload\n'
  printf 'that would silently drop them (the branch protection PUT endpoint\n'
  printf 'is a full replace).\n'
  printf 'Review the existing rule and update it manually:\n'
  printf '  gh api "repos/%s/branches/%s/protection"\n' "$owner_repo" "$branch"
}

# ---------- resolve --repo/--branch when not given ----------
if [ -z "$REPO" ] || [ -z "$BRANCH" ]; then
  command -v git >/dev/null 2>&1 || die "git not found on PATH (or pass --repo and --branch)"
  git rev-parse --is-inside-work-tree >/dev/null 2>&1 \
    || die "not inside a git repo (pass --repo and --branch)"
  detect_dir="$(default_gh_dir)"
  repo_json="$(env GH_CONFIG_DIR="$detect_dir" \
    gh repo view --json nameWithOwner,defaultBranchRef 2>/dev/null || true)"
  [ -n "$repo_json" ] || die "could not resolve repo via gh repo view (pass --repo and --branch)"
  [ -n "$REPO" ] || REPO="$(printf '%s' "$repo_json" | jq -r '.nameWithOwner // empty')"
  [ -n "$BRANCH" ] || BRANCH="$(printf '%s' "$repo_json" | jq -r '.defaultBranchRef.name // empty')"
fi
[ -n "$REPO" ] && [ -n "$BRANCH" ] || die "could not resolve owner/repo or branch"

# ---------- --manual ----------
if [ "$MODE" = "manual" ]; then
  print_manual_block "$REPO" "$BRANCH"
  exit 0
fi

# ---------- --status ----------
if [ "$MODE" = "status" ]; then
  gh_dir="$(default_gh_dir)"
  class="$(classify_branch_protection "$gh_dir" "$REPO" "$BRANCH")"

  admin_dir=""
  case "$class" in
    unprotected|protected-insufficient|no-admin)
      admin_dir="$(resolve_admin_gh_dir "$REPO" || true)" ;;
  esac

  if $JSON; then
    jq -n --arg repo "$REPO" --arg branch "$BRANCH" --arg class "$class" \
      --arg gh_dir "$gh_dir" --arg admin_gh_dir "$admin_dir" \
      '{repo: $repo, branch: $branch, class: $class, gh_dir: $gh_dir,
        admin_gh_dir: (if ($admin_gh_dir | length) > 0 then $admin_gh_dir else null end)}'
  elif ! $QUIET; then
    printf '%s/%s: %s\n' "$REPO" "$BRANCH" "$class"
  fi
  exit 0
fi

# ---------- --apply ----------
probe_dir="$(default_gh_dir)"
class="$(classify_branch_protection "$probe_dir" "$REPO" "$BRANCH")"

emit_result() {
  local status="$1" identity="${2:-}" gh_dir="${3:-}" enforce_relaxed="${4:-false}"
  if $JSON; then
    jq -n --arg status "$status" --arg repo "$REPO" --arg branch "$BRANCH" \
      --arg class "$class" --arg identity "$identity" --arg gh_dir "$gh_dir" \
      '{status: $status, repo: $repo, branch: $branch, class: $class,
        identity: (if ($identity | length) > 0 then $identity else null end),
        gh_dir: (if ($gh_dir | length) > 0 then $gh_dir else null end)}'
  elif ! $QUIET; then
    case "$status" in
      already-sufficient) printf 'already sufficient: %s/%s requires >=1 approving review\n' "$REPO" "$BRANCH" ;;
      already-protected)  printf 'already protected: %s/%s (admin token needed to verify the exact review count)\n' "$REPO" "$BRANCH" ;;
      applied)
        printf 'applied: %s/%s now requires >=1 approving review (as %s)\n' "$REPO" "$BRANCH" "$identity"
        # enforce_admins is always kept false (load-bearing: it lets the bot
        # squash-merge its own approved PRs) — but when the existing rule had
        # it true, that is a silent weakening of an operator-set control, so
        # name it here rather than only in the source comment (#45 review,
        # critical finding sub-point (a)).
        if [ "$enforce_relaxed" = "true" ]; then
          printf '  note: enforce_admins was true on the existing rule and is kept false (required for the bot'"'"'s own squash-merges)\n'
        fi
        ;;
    esac
  fi
}

case "$class" in
  protected-sufficient)
    emit_result "already-sufficient"
    exit 0
    ;;
  protected-noadmin)
    emit_result "already-protected"
    exit 0
    ;;
  skip:*)
    msg="${class#skip:}"
    if $JSON; then
      jq -n --arg repo "$REPO" --arg branch "$BRANCH" --arg msg "$msg" \
        '{status: "skip", repo: $repo, branch: $branch, message: $msg}'
    else
      printf 'branch protection check skipped: %s\n' "$msg" >&2
    fi
    exit 2
    ;;
esac

# unprotected | protected-insufficient | no-admin — needs an admin identity.
if ! admin_dir="$(resolve_admin_gh_dir "$REPO")"; then
  print_manual_block "$REPO" "$BRANCH"
  exit 3
fi

apply_out="$(apply_protection "$admin_dir" "$REPO" "$BRANCH")"; apply_rc=$?

if [ "$apply_rc" -eq 0 ]; then
  apply_status="$(printf '%s\n' "$apply_out" | sed -n '1p')"
  verify_class="$(printf '%s\n' "$apply_out" | sed -n '2p')"
  enforce_relaxed="$(printf '%s\n' "$apply_out" | sed -n '3p')"
  identity_login="$(env GH_CONFIG_DIR="$admin_dir" gh api user --jq .login 2>/dev/null || true)"
  class="$verify_class"
  emit_result "$apply_status" "$identity_login" "$admin_dir" "$enforce_relaxed"
  exit 0
fi

if [ "$apply_rc" -eq 2 ]; then
  print_unmergeable_block "$REPO" "$BRANCH"
  exit 3
fi

if [ "$apply_rc" -eq 3 ]; then
  # The admin identity's re-read of the existing rule failed for a reason
  # that is NOT a confirmed-unprotected 404 — never treat that as license to
  # PUT a MIN_PAYLOAD full-replace over a rule we simply failed to read
  # (#45 review, critical finding). apply_protection() already wrote the
  # underlying gh error to stderr.
  if $JSON; then
    jq -n --arg repo "$REPO" --arg branch "$BRANCH" --arg class "$class" \
      '{status: "read-failed", repo: $repo, branch: $branch, class: $class,
        message: "could not verify the existing rule under the admin identity; refusing to apply without reading it first"}'
  else
    printf 'could not verify existing branch protection on %s/%s under the admin identity — refusing to apply without reading it first (see stderr for the underlying error)\n' "$REPO" "$BRANCH" >&2
  fi
  exit 2
fi

identity_login="$(env GH_CONFIG_DIR="$admin_dir" gh api user --jq .login 2>/dev/null || true)"
if $JSON; then
  jq -n --arg repo "$REPO" --arg branch "$BRANCH" --arg class "$class" \
    --arg identity "$identity_login" --arg gh_dir "$admin_dir" \
    '{status: "put-failed", repo: $repo, branch: $branch, class: $class,
      identity: $identity, gh_dir: $gh_dir}'
else
  printf 'failed to apply branch protection on %s/%s (as %s)\n' "$REPO" "$BRANCH" "$identity_login" >&2
fi
exit 4
